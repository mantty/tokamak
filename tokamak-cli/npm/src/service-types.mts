import fs from "node:fs";
import path from "node:path";
import type { NativeService } from "./worker-types.mjs";

export interface ServiceMethod {
  name: string;
  overloads: number;
  documentation: string;
}

/** Retain the original types while making every exposed overload asynchronous. */
export function serviceTypes(instance: string, methods: ServiceMethod[], name = "Tokamak"): string {
  const counts = [...new Set(methods.map((method) => method.overloads))].sort((a, b) => a - b);
  const helpers = counts.map((count) => {
    const signatures = Array.from({ length: count }, (_, index) => index);
    const match = signatures.map((index) => `(...args: infer A${index}): infer R${index};`);
    const wrapped = signatures.map((index) => `(...args: A${index}): Promise<Awaited<R${index}>>;`);
    return `type Async${count}<T> = T extends {\n  ${match.join("\n  ")}\n} ? {\n  ${wrapped.join("\n  ")}\n} : never;`;
  });
  const members = methods.map(({ name, overloads, documentation }) => {
    const comment = documentation ? `  /** ${documentation.replaceAll("*/", "* /").replaceAll("\n", "\n   * ")} */\n` : "";
    return `${comment}  ${JSON.stringify(name)}: Async${overloads}<Worker[${JSON.stringify(name)}]>;`;
  });
  const operations = methods.map(({ name }) => JSON.stringify(name)).join(" | ") || "never";
  return `type Worker = ${instance};

${helpers.join("\n\n")}

export interface ${name}Operations {
${members.join("\n")}
}

export interface ${name}Client extends ${name}Operations {
  /** Whether each operation is implemented where the app runs. It does not report permission or promise that a call succeeds. */
  readonly capabilities: Readonly<Record<${operations}, boolean>>;
}

export interface ${name}Service extends ${name}Operations {
  fetch(input: Request | string | URL, init?: RequestInit): Promise<Response>;
}
`;
}

export function writeEnvironmentTypes(root: string, services: NativeService[], main: string, bindings: string[]): void {
  const file = path.join(root, "tokamak-env.d.ts");
  const previous = fs.existsSync(file) ? fs.readFileSync(file, "utf8") : undefined;
  if (previous !== undefined && !previous.startsWith("// Generated by tokamak.\n")) {
    throw new Error(`${file} is reserved for generated Tokamak types; move the existing declarations to another file.`);
  }
  const clients = services.map(service => `declare module ${JSON.stringify(service.client)} {
${service.contract.declarations.trimEnd().split("\n").map(line => line ? `  ${line}` : line).join("\n")}
  const client: TokamakClient;
  export default client;
}`).join("\n\n");
  const source = `// Generated by tokamak.
${clients}

declare namespace Cloudflare {
  interface Env {
${services.map(service => `    ${service.binding}?: import(${JSON.stringify(service.client)}).TokamakService;`).join("\n")}
  }
}

declare namespace Tokamak {
${main.trimEnd().split("\n").map(line => line ? `  ${line}` : line).join("\n")}
  interface Env extends Pick<Cloudflare.Env, Extract<keyof Cloudflare.Env, ${bindings.map(name => JSON.stringify(name)).join(" | ") || "never"}>> {
    MAIN: MainService;
  }
}
`;
  if (previous !== source) fs.writeFileSync(file, source);
}
