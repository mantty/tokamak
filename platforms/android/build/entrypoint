#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 3 || $1 != build ]]; then
  echo "usage: entrypoint build INPUT OUTPUT" >&2
  exit 2
fi

input=$2
output=$3
metadata=$input/metadata
app_name=$(cat "$metadata/app-name")
host=$(cat "$metadata/host")
platform=$(cat "$metadata/platform")
identifier=$(cat "$metadata/identifier")
version=1.0
if [[ -f "$metadata/version" ]]; then
  version=$(cat "$metadata/version")
fi
dev_endpoint=
dev_session_token=
if [[ -f "$metadata/dev-endpoint" ]]; then
  dev_endpoint=$(cat "$metadata/dev-endpoint")
fi
if [[ -f "$metadata/dev-session-token" ]]; then
  dev_session_token=$(cat "$metadata/dev-session-token")
fi
if [[ -n "$dev_endpoint" && -z "$dev_session_token" ]] || [[ -z "$dev_endpoint" && -n "$dev_session_token" ]]; then
  echo "development endpoint and session token must be provided together" >&2
  exit 1
fi
user_manifest=
if [[ -n "${TOKAMAK_ANDROID_MANIFEST:-}" ]]; then
  user_manifest=$TOKAMAK_ANDROID_MANIFEST
  if [[ ! -f "$user_manifest" ]]; then
    echo "Android manifest file is missing: $user_manifest" >&2
    exit 1
  fi
fi
project=$(dirname "$output")/.tokamak
app=$project/app
native=$app/src/main/jniLibs/arm64-v8a
assets=$app/src/main/assets/app
kotlin=$app/src/main/kotlin/com/tokamak/runtime
plugin_api=$project/tokamak-plugin
plugin_modules=$project/plugins
icons=$input/icons/$platform

xml_escape() {
  printf '%s' "$1" |
    sed -e 's/&/\&amp;/g' \
      -e 's/</\&lt;/g' \
      -e 's/>/\&gt;/g' \
      -e 's/"/\&quot;/g' \
      -e "s/'/\&apos;/g"
}

rm -rf "$app/src/main/assets" "$app/src/main/jniLibs" "$app/src/main/kotlin" "$app/src/main/res" "$app/user" "$plugin_api" "$plugin_modules" "$output"
mkdir -p "$native" "$assets" "$kotlin" "$app/src/main/res" "$plugin_api/src/main/kotlin"
cp -R "$input/app/." "$assets/"
cp "$input/runtime/libtokamak.so" "$native/libtokamak.so"
cp -R "$input/native-shell/app/." "$kotlin/"
cp -R "$input/native-shell/plugin/." "$plugin_api/src/main/kotlin/"
cat > "$plugin_api/build.gradle" <<'EOF'
plugins {
  id 'com.android.library'
  id 'org.jetbrains.kotlin.android'
}

android {
  namespace 'com.tokamak.runtime.plugin'
}
EOF

has_icon=false
if [[ -d "$icons" ]]; then
  cp -R "$icons/." "$app/src/main/res/"
  shopt -s nullglob
  launcher_resources=("$app/src/main/res"/mipmap*/ic_launcher.*)
  if (( ${#launcher_resources[@]} == 0 )); then
    echo "Android icon resources must define mipmap/ic_launcher" >&2
    exit 1
  fi
  has_icon=true
fi

# Each plugin is a library module, so its manifest merges below the app's and
# its dependencies stay its own.
shopt -s nullglob
for plugin in "$input/plugins"/*/; do
  plugin_id=$(basename "$plugin")
  module=$plugin_modules/$plugin_id
  mkdir -p "$module/src/main/kotlin"
  for source in "$plugin/sources"/*; do
    [[ -f "$source" ]] || continue
    case "$source" in
      *.kt)
        cp "$source" "$module/src/main/kotlin/$(basename "$source")"
        ;;
      *)
        echo "Android plugin source must be Kotlin: $source" >&2
        exit 1
        ;;
    esac
  done
  if [[ -f "$plugin/AndroidManifest.xml" ]]; then
    cp "$plugin/AndroidManifest.xml" "$module/src/main/AndroidManifest.xml"
  fi
  {
    printf '%s\n' 'plugins {'
    printf '%s\n' "  id 'com.android.library'"
    printf '%s\n' "  id 'org.jetbrains.kotlin.android'"
    printf '%s\n\n' '}'
    printf '%s\n' 'android {'
    printf "  namespace 'tokamak.plugins.%s'\n" "${plugin_id//-/_}"
    printf '%s\n\n' '}'
    printf '%s\n' 'dependencies {'
    printf '%s\n' "  implementation project(':tokamak-plugin')"
    for dependency in "$plugin/dependencies"/*; do
      printf "  implementation '%s'\n" "$(cat "$dependency")"
    done
    printf '%s\n' '}'
  } > "$module/build.gradle"
done

mkdir -p "$project/app/src/main"
cat > "$project/settings.gradle" <<'EOF'
pluginManagement {
  repositories {
    google()
    mavenCentral()
    gradlePluginPortal()
  }
}
dependencyResolutionManagement {
  repositoriesMode.set(RepositoriesMode.FAIL_ON_PROJECT_REPOS)
  repositories {
    google()
    mavenCentral()
  }
}
rootProject.name = 'tokamak'
include ':app', ':tokamak-plugin'
EOF
for plugin in "$input/plugins"/*/; do
  printf "include ':plugins:%s'\n" "$(basename "$plugin")" >> "$project/settings.gradle"
done

cat > "$project/build.gradle" <<'EOF'
plugins {
  id 'com.android.application' version '8.7.3' apply false
  id 'com.android.library' version '8.7.3' apply false
  id 'org.jetbrains.kotlin.android' version '2.1.0' apply false
}

subprojects {
  plugins.withId('com.android.library') {
    android {
      compileSdk 35
      defaultConfig {
        minSdk 31
      }
      sourceSets {
        main {
          kotlin.srcDirs += 'src/main/kotlin'
        }
      }
      compileOptions {
        sourceCompatibility JavaVersion.VERSION_17
        targetCompatibility JavaVersion.VERSION_17
      }
    }
  }
  plugins.withId('org.jetbrains.kotlin.android') {
    kotlin {
      jvmToolchain(17)
    }
  }
}
EOF

printf '%s\n' 'android.useAndroidX=true' > "$project/gradle.properties"
cat > "$project/app/build.gradle" <<EOF
plugins {
  id 'com.android.application'
  id 'org.jetbrains.kotlin.android'
}

android {
  namespace 'com.tokamak.runtime'
  compileSdk 35

  defaultConfig {
    applicationId '$identifier'
    minSdk 31
    targetSdk 35
    versionCode 1
    versionName '$version'
  }

  androidResources {
    ignoreAssetsPattern = ''
  }

  sourceSets {
    main {
      kotlin.srcDirs += 'src/main/kotlin'
    }
  }

  compileOptions {
    sourceCompatibility JavaVersion.VERSION_17
    targetCompatibility JavaVersion.VERSION_17
  }

  lint {
    checkOnly 'NewApi'
    abortOnError true
    checkDependencies true
  }
}

dependencies {
  implementation 'androidx.webkit:webkit:1.12.1'
  implementation project(':tokamak-plugin')
EOF
for plugin in "$input/plugins"/*/; do
  printf "  implementation project(':plugins:%s')\n" "$(basename "$plugin")" >> "$project/app/build.gradle"
done
printf '%s\n' '}' >> "$project/app/build.gradle"

if [[ -n "$user_manifest" ]]; then
  mkdir -p "$app/user"
  cp "$user_manifest" "$app/user/AndroidManifest.xml"
  cat >> "$project/app/build.gradle" <<'EOF'

androidComponents {
  onVariants(selector().all()) { variant ->
    variant.sources.manifests.addStaticManifestFile(file('user/AndroidManifest.xml').path)
  }
}
EOF
fi

registry=$kotlin/TokamakPluginRegistry.kt
{
  printf '%s\n\n' 'package com.tokamak.runtime'
  printf '%s\n' 'internal fun tokamakPlugins(host: TokamakHost): List<TokamakPlugin> ='
  printf '%s\n' '    listOf('
  for plugin in "$input/plugins"/*/; do
    printf '        %s(host),\n' "$(cat "$plugin/class")"
  done
  printf '%s\n' '    )'
} > "$registry"

manifest=$app/src/main/AndroidManifest.xml
{
  printf '%s\n' '<manifest xmlns:android="http://schemas.android.com/apk/res/android">'
  {
    printf '%s\n' android.permission.INTERNET
    for permission in "$input/plugins"/*/permissions/*; do
      printf '%s\n' "$(cat "$permission")"
    done
  } | sort -u | while IFS= read -r permission; do
    printf '  <uses-permission android:name="%s" />\n' "$permission"
  done
  icon_attribute=
  if [[ "$has_icon" == true ]]; then
    icon_attribute=' android:icon="@mipmap/ic_launcher"'
  fi
  printf '  <application android:name=".TokamakApplication" android:label="%s"%s android:usesCleartextTraffic="false">\n' "$(xml_escape "$app_name")" "$icon_attribute"
  printf '    <meta-data android:name="tokamak.host" android:value="%s" />\n' "$host"
  if [[ -n "$dev_endpoint" ]]; then
    printf '    <meta-data android:name="tokamak.dev.endpoint" android:value="%s" />\n' "$dev_endpoint"
    printf '    <meta-data android:name="tokamak.dev.session-token" android:value="%s" />\n' "$dev_session_token"
  fi
  printf '%s\n' '    <activity android:name=".TokamakActivity" android:exported="true" android:launchMode="singleTask" android:theme="@android:style/Theme.Material.NoActionBar" android:configChanges="colorMode|density|fontScale|keyboard|keyboardHidden|layoutDirection|locale|mcc|mnc|navigation|orientation|screenLayout|screenSize|smallestScreenSize|touchscreen|uiMode">'
  printf '%s\n' '      <intent-filter>'
  printf '%s\n' '        <action android:name="android.intent.action.MAIN" />'
  printf '%s\n' '        <category android:name="android.intent.category.LAUNCHER" />'
  printf '%s\n' '      </intent-filter>'
  printf '%s\n' '    </activity>'
  printf '%s\n' '  </application>'
  printf '%s\n' '</manifest>'
} > "$manifest"

gradle --no-daemon :app:lintDebug :app:assembleDebug --project-dir "$project"
mkdir -p "$(dirname "$output")"
cp "$app/build/outputs/apk/debug/app-debug.apk" "$output"
