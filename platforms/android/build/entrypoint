#!/usr/bin/env bash
set -euo pipefail

# The CLI runs the entrypoint from the pack root.
pack=$PWD

# The build tools of apps and of describing plugins.
agp_version=8.7.3
kotlin_version=2.1.0

# The start of a Gradle project's settings.gradle: the repositories it
# resolves plugins and dependencies from.
gradle_repositories() {
  cat <<'EOF'
pluginManagement {
  repositories {
    google()
    mavenCentral()
    gradlePluginPortal()
  }
}
dependencyResolutionManagement {
  repositories {
    google()
    mavenCentral()
  }
}
EOF
}

# The start of a Gradle project's build.gradle: the build tools its modules
# apply, and the Kotlin options every module compiles with. Interface default
# methods compile into the interface, not into each implementing class, which
# incremental builds do not recompile when a Tokamak interface in another
# module gains or changes one.
gradle_plugins() {
  cat <<EOF
plugins {
  id 'com.android.application' version '$agp_version' apply false
  id 'com.android.library' version '$agp_version' apply false
  id 'org.jetbrains.kotlin.android' version '$kotlin_version' apply false
}

subprojects {
  plugins.withId('org.jetbrains.kotlin.android') {
    kotlin {
      jvmToolchain(17)
      compilerOptions {
        freeCompilerArgs.add('-Xjvm-default=all')
      }
    }
  }
}
EOF
}

# Describes the methods REGISTRATION, the plugin's Exports.kt, exports into
# OUTPUT/description.json, with the dispatch that serves them,
# OUTPUT/Exports.generated.kt. A JVM unit test, which depends on the plugin's
# module, runs the registration and reflects on the methods it lists. The
# plugin's module builds outside its directory, without the dispatch
# describing regenerates.
describe() {
  local plugin=$1 registration=$2 output=$3
  if [[ $# -ne 4 || $4 != android ]]; then
    echo "Android plugins run on android, not ${*:4}" >&2
    exit 2
  fi
  local sdk=${ANDROID_HOME:-${ANDROID_SDK_ROOT:-}}
  if ! command -v gradle > /dev/null || ! command -v java > /dev/null || [[ ! -d "$sdk/platforms" ]]; then
    echo "Describing an Android plugin needs Gradle, Java and the Android SDK" >&2
    exit 69
  fi
  # Global, for the exit trap.
  temporary=$(mktemp -d "${TMPDIR:-/tmp}/tokamak-describe.XXXXXX")
  trap 'rm -rf "$temporary"' EXIT
  local describer=$temporary/describer plugin_build=$temporary/plugin-build
  mkdir -p "$describer"
  {
    gradle_repositories
    printf '%s\n' "rootProject.name = 'tokamak-describe'" "include ':tokamak-plugin', ':plugin', ':describer'"
    printf "project(':tokamak-plugin').projectDir = file('%s')\n" "$pack/plugin-api"
    printf "project(':plugin').projectDir = file('%s')\n" "$plugin/android"
  } > "$temporary/settings.gradle"
  {
    gradle_plugins
    cat <<EOF

project(':plugin') {
  layout.buildDirectory.set(file('$plugin_build'))
  tasks.withType(org.jetbrains.kotlin.gradle.tasks.KotlinCompile).configureEach {
    exclude { it.file == file('${registration%/*}/Exports.generated.kt') }
  }
}
EOF
  } > "$temporary/build.gradle"
  printf '%s\n' 'android.useAndroidX=true' > "$temporary/gradle.properties"
  cat > "$describer/build.gradle" <<EOF
plugins {
  id 'com.android.library'
  id 'org.jetbrains.kotlin.android'
}

android {
  namespace 'tokamak.describe'
  compileSdk 35
  sourceSets {
    test.kotlin.srcDirs = ['$pack/describer']
  }
  defaultConfig {
    minSdk $(<"$pack/build/min-sdk")
  }
  testOptions {
    unitTests.returnDefaultValues = true
    unitTests.all {
      systemProperty 'tokamak.output', '$output'
      systemProperty 'tokamak.classes', '$plugin_build/tmp/kotlin-classes/debug'
      outputs.upToDateWhen { false }
    }
  }
}

dependencies {
  testImplementation project(':tokamak-plugin')
  testImplementation project(':plugin')
  testImplementation 'junit:junit:4.13.2'
  testImplementation 'org.jetbrains.kotlin:kotlin-reflect:$kotlin_version'
  // android.jar's org.json is stubs; the describer writes JSON with the reference implementation.
  testImplementation 'org.json:json:20250517'
}
EOF
  gradle --quiet --project-dir "$temporary" :describer:testDebugUnitTest
  if [[ -f "$output/error" ]]; then
    cat "$output/error" >&2
    rm "$output/error"
    exit 1
  fi
}
if [[ $# -ge 1 && $1 == describe ]]; then
  describe "${@:2}"
  exit
fi

if [[ $# -ne 3 || $1 != build ]]; then
  echo "usage: entrypoint build INPUT OUTPUT | entrypoint describe PLUGIN REGISTRATION OUTPUT android" >&2
  exit 2
fi

input=$2
output=$3
metadata=$input/metadata
app_name=$(cat "$metadata/app-name")
host=$(cat "$metadata/host")
identifier=$(cat "$metadata/identifier")
version=1.0
if [[ -f "$metadata/version" ]]; then
  version=$(cat "$metadata/version")
fi
dev_endpoint=
dev_session_token=
if [[ -f "$metadata/dev-endpoint" ]]; then
  dev_endpoint=$(cat "$metadata/dev-endpoint")
  dev_session_token=$(cat "$metadata/dev-session-token")
fi
# Development builds are debug builds. Other builds are release builds,
# which R8 shrinks and a configured keystore signs; without one, the debug
# key signs them so they install for testing. Gradle reads the keystore
# settings from the environment.
variant=release
task=Release
if [[ -n "$dev_endpoint" ]]; then
  variant=debug
  task=Debug
fi
signing=debug
if [[ "$variant" == release && -n "${TOKAMAK_ANDROID_KEYSTORE:-}" ]]; then
  if [[ ! -f "$TOKAMAK_ANDROID_KEYSTORE" ]]; then
    echo "Android keystore is missing: $TOKAMAK_ANDROID_KEYSTORE" >&2
    exit 1
  fi
  if [[ -z "${TOKAMAK_ANDROID_KEY_ALIAS:-}" || -z "${TOKAMAK_ANDROID_KEYSTORE_PASSWORD:-}" ]]; then
    echo "an Android keystore needs key-alias and keystore-password" >&2
    exit 1
  fi
  signing=release
elif [[ "$variant" == release && -n "${TOKAMAK_ANDROID_KEY_ALIAS:-}${TOKAMAK_ANDROID_KEYSTORE_PASSWORD:-}${TOKAMAK_ANDROID_KEY_PASSWORD:-}" ]]; then
  echo "Android key-alias and passwords need a keystore" >&2
  exit 1
fi
user_manifest=
if [[ -n "${TOKAMAK_ANDROID_MANIFEST:-}" ]]; then
  user_manifest=$TOKAMAK_ANDROID_MANIFEST
  if [[ ! -f "$user_manifest" ]]; then
    echo "Android manifest file is missing: $user_manifest" >&2
    exit 1
  fi
fi
icon=${TOKAMAK_ANDROID_ICON:-}
if [[ -n "$icon" && ! -d "$icon" ]]; then
  echo "android.icon must be an Android res directory: $icon" >&2
  exit 1
fi
project=$(dirname "$output")/.tokamak
app=$project/app
native=$app/src/main/jniLibs/arm64-v8a
assets=$app/src/main/assets/app
kotlin=$app/src/main/kotlin/com/tokamak/runtime
plugin_api=$project/tokamak-plugin
plugin_modules=$project/plugins
generated_modules=$project/generated
# The oldest Android API level the app supports.
min_sdk=$(<"$pack/build/min-sdk")

# The Android NDK's compiler, which links the runtime into the app.
android_linker() {
  local ndk=${ANDROID_NDK_HOME:-}
  local sdk_root=${ANDROID_HOME:-${ANDROID_SDK_ROOT:-}}
  if [[ ! -d "$ndk" && -n "$sdk_root" && -d "$sdk_root/ndk" ]]; then
    ndk=$(find "$sdk_root/ndk" -mindepth 1 -maxdepth 1 -type d -print | sort | tail -n 1)
  fi
  local compiler
  for compiler in "$ndk"/toolchains/llvm/prebuilt/*/bin/aarch64-linux-android"$min_sdk"-clang; do
    if [[ -x "$compiler" ]]; then
      printf '%s' "$compiler"
      return
    fi
  done
  echo "Android builds link the tokamak runtime with the Android NDK, which is not installed." >&2
  echo "Install it with Android Studio's SDK Manager (SDK Tools > NDK) or \`sdkmanager \"ndk;29.0.14206865\"\`, or set ANDROID_NDK_HOME." >&2
  exit 1
}

# Link the runtime into libtokamak.so, exporting the JNI functions and the
# entry points of the runtime parts the app links.
link_runtime() {
  local runtime=$pack/lib/TokamakRuntime
  local exports=$project/tokamak-exports.map
  local compiler libraries
  compiler=$(android_linker)
  {
    printf '{\n  global:\n    Java_*;\n'
    sed 's/.*/    &;/' "$metadata/exported-symbols"
    printf '  local:\n    *;\n};\n'
  } > "$exports"
  read -r -a libraries <<< "$(< "$runtime/link-libraries")"
  "$compiler" -shared -o "$native/libtokamak.so" \
    -Wl,-soname,libtokamak.so \
    -Wl,--whole-archive "$runtime/libtokamak.a" -Wl,--no-whole-archive \
    -Wl,--version-script="$exports" \
    -Wl,--gc-sections -Wl,--as-needed -Wl,--eh-frame-hdr \
    -Wl,-z,noexecstack -Wl,-z,relro,-z,now -Wl,-z,max-page-size=16384 \
    -Wl,--strip-all \
    "${libraries[@]}"
}

# The signing configuration for a keystore that signs release builds.
release_signing() {
  if [[ "$signing" != release ]]; then
    return
  fi
  cat <<'EOF'
  signingConfigs {
    release {
      storeFile file(System.getenv('TOKAMAK_ANDROID_KEYSTORE'))
      storePassword System.getenv('TOKAMAK_ANDROID_KEYSTORE_PASSWORD')
      keyAlias System.getenv('TOKAMAK_ANDROID_KEY_ALIAS')
      keyPassword System.getenv('TOKAMAK_ANDROID_KEY_PASSWORD') ?: System.getenv('TOKAMAK_ANDROID_KEYSTORE_PASSWORD')
    }
  }

EOF
}

xml_escape() {
  printf '%s' "$1" |
    sed -e 's/&/\&amp;/g' \
      -e 's/</\&lt;/g' \
      -e 's/>/\&gt;/g' \
      -e 's/"/\&quot;/g' \
      -e "s/'/\&apos;/g"
}

rm -rf "$app/src/main/assets" "$app/src/main/jniLibs" "$app/src/main/kotlin" "$app/src/main/res" "$app/user" "$plugin_api" "$plugin_modules" "$generated_modules" "$output"
mkdir -p "$native" "$assets" "$kotlin" "$app/src/main/res" "$plugin_modules" "$generated_modules"
cp -R "$input/app/." "$assets/"
link_runtime
cp -R "$pack/native-shell/app/." "$kotlin/"
cp -R "$pack/plugin-api" "$plugin_api"

has_icon=false
if [[ -n "$icon" ]]; then
  cp -R "$icon/." "$app/src/main/res/"
  shopt -s nullglob
  launcher_resources=("$app/src/main/res"/mipmap*/ic_launcher.*)
  if (( ${#launcher_resources[@]} == 0 )); then
    echo "Android icon resources must define mipmap/ic_launcher" >&2
    exit 1
  fi
  has_icon=true
fi

# Each plugin's Gradle module is a library module of the app, so its manifest
# merges below the app's and its dependencies resolve with the app's. Its class
# is a Kotlin class name in a package, which the registry creates. The
# manifest and raw resources its build script generates are a library module of
# their own.
kotlin_class='^[A-Za-z_][A-Za-z0-9_]*(\.[A-Za-z_][A-Za-z0-9_]*)+$'
registry=$kotlin/TokamakPluginRegistry.kt
printf '%s\n\n%s\n%s\n' 'package com.tokamak.runtime' 'internal fun tokamakPlugins(app: TokamakApplication): List<TokamakPlugin> =' '    listOf(' > "$registry"
shopt -s nullglob
raw_names=" "
module_includes=
module_dependencies=
# Includes the module $1 in the build, as a dependency of the app.
include_module() {
  module_includes+="include '$1'"$'\n'
  module_dependencies+="  implementation project('$1')"$'\n'
}
for plugin in "$input/plugins"/*/; do
  plugin_id=$(basename "$plugin")
  class=$(cat "$plugin/class" 2>/dev/null || true)
  if [[ ! "$class" =~ $kotlin_class ]]; then
    echo "plugin '$plugin_id' has invalid android class '$class'" >&2
    exit 1
  fi
  if [[ ! -f "$plugin/native/build.gradle.kts" && ! -f "$plugin/native/build.gradle" ]]; then
    echo "plugin '$plugin_id' has no Gradle module, android/build.gradle.kts" >&2
    exit 1
  fi
  cp -R "$plugin/native" "$plugin_modules/$plugin_id"
  include_module ":plugins:$plugin_id"
  # A plugin that exports methods runs behind the dispatch generated for it,
  # whose companion object converts its values for its host.
  if [[ -n "$(find "$plugin/native" -name Exports.kt -print -quit)" ]]; then
    printf '        %sDispatch(app.host("%s", %sDispatch)),\n' "$class" "$plugin_id" "$class" >> "$registry"
  else
    printf '        %s(app.host("%s")),\n' "$class" "$plugin_id" >> "$registry"
  fi
  generated=$generated_modules/$plugin_id
  if [[ -f "$plugin/manifest" ]]; then
    mkdir -p "$generated/src/main"
    cp "$plugin/manifest" "$generated/src/main/AndroidManifest.xml"
  fi
  for resource in "$plugin/raw"/*; do
    [[ -f "$resource" ]] || continue
    name=${resource##*/}
    name=${name#*-}
    # Android names a raw resource without its extension, across every plugin.
    if [[ "$raw_names" == *" ${name%%.*} "* ]]; then
      echo "plugin '$plugin_id' raw resource '$name' has the name of another plugin resource" >&2
      exit 1
    fi
    raw_names+=" ${name%%.*} "
    mkdir -p "$generated/src/main/res/raw"
    cp "$resource" "$generated/src/main/res/raw/$name"
  done
  if [[ -d "$generated" ]]; then
    cat > "$generated/build.gradle" <<EOF
plugins {
  id 'com.android.library'
}

android {
  namespace 'tokamak.generated.${plugin_id//-/_}'
  compileSdk 35
  defaultConfig {
    minSdk $min_sdk
  }
}
EOF
    include_module ":generated:$plugin_id"
  fi
done
printf '%s\n' '    )' >> "$registry"

{
  gradle_repositories
  printf '%s\n' "rootProject.name = 'tokamak'" "include ':app', ':tokamak-plugin'"
  printf '%s' "$module_includes"
} > "$project/settings.gradle"

# Every module's dependencies resolve to at least the versions the app's lock
# pins, in Gradle's lock files. The lock is lenient because Gradle can resolve
# a locked build differently from the build that wrote the lock
# (gradle/gradle#21396). Without a lock, the build writes one, resolving every
# module's compile and runtime classpaths, which debug and release builds use.
lock=$input/lock
gradle_arguments=("-Ptokamak.version=$version" ":app:lint$task" ":app:assemble$task")
if [[ ! -d "$lock" ]]; then
  gradle_arguments+=(--write-locks tokamakLockDependencies)
  mkdir -p "$lock"
fi
{
  gradle_plugins
  cat <<EOF

subprojects {
  plugins.withType(com.android.build.gradle.api.AndroidBasePlugin) {
    dependencyLocking {
      lockAllConfigurations()
      lockMode = LockMode.LENIENT
      lockFile = file('$lock/' + path.substring(1).replace(':', '.') + '.lockfile')
    }
    tasks.register('tokamakLockDependencies') {
      def classpaths = configurations.matching { it.name.endsWith('CompileClasspath') || it.name.endsWith('RuntimeClasspath') }
      doLast {
        classpaths.each { it.incoming.resolutionResult.root }
      }
    }
  }
}
EOF
} > "$project/build.gradle"

# Lint and R8 run in the Gradle daemon, whose default 512 MiB heap runs out
# when they analyse an app with several plugin modules.
printf '%s\n' 'android.useAndroidX=true' 'org.gradle.jvmargs=-Xmx4g' > "$project/gradle.properties"
cat > "$project/app/build.gradle" <<EOF
plugins {
  id 'com.android.application'
  id 'org.jetbrains.kotlin.android'
}

android {
  namespace 'com.tokamak.runtime'
  compileSdk 35

  defaultConfig {
    applicationId '$identifier'
    minSdk $min_sdk
    targetSdk 35
    versionCode 1
    versionName providers.gradleProperty('tokamak.version').get()
  }

  androidResources {
    ignoreAssetsPattern = ''
  }

  lint {
    checkOnly 'NewApi'
    abortOnError true
    checkDependencies true
  }

$(release_signing)
  buildTypes {
    release {
      minifyEnabled true
      proguardFiles getDefaultProguardFile('proguard-android-optimize.txt'), 'tokamak-rules.pro'
      signingConfig signingConfigs.$signing
    }
  }
}

dependencies {
  implementation 'androidx.lifecycle:lifecycle-process:2.11.0'
  implementation 'androidx.webkit:webkit:1.12.1'
  implementation project(':tokamak-plugin')
EOF
printf '%s}\n' "$module_dependencies" >> "$project/app/build.gradle"

if [[ -n "$user_manifest" ]]; then
  mkdir -p "$app/user"
  cp "$user_manifest" "$app/user/AndroidManifest.xml"
  cat >> "$project/app/build.gradle" <<'EOF'

androidComponents {
  onVariants(selector().all()) { variant ->
    variant.sources.manifests.addStaticManifestFile(file('user/AndroidManifest.xml').path)
  }
}
EOF
fi

manifest=$app/src/main/AndroidManifest.xml
{
  printf '%s\n' \
    '<manifest xmlns:android="http://schemas.android.com/apk/res/android">' \
    '  <uses-permission android:name="android.permission.INTERNET" />'
  icon_attribute=
  if [[ "$has_icon" == true ]]; then
    icon_attribute=' android:icon="@mipmap/ic_launcher"'
  fi
  printf '  <application android:name=".TokamakApplication" android:label="%s"%s>\n' "$(xml_escape "$app_name")" "$icon_attribute"
  printf '    <meta-data android:name="tokamak.host" android:value="%s" />\n' "$host"
  if [[ -n "$dev_endpoint" ]]; then
    printf '    <meta-data android:name="tokamak.dev.endpoint" android:value="%s" />\n' "$dev_endpoint"
    printf '    <meta-data android:name="tokamak.dev.session-token" android:value="%s" />\n' "$dev_session_token"
  fi
  printf '%s\n' \
    '    <activity android:name=".TokamakActivity" android:exported="true" android:launchMode="singleTask" android:theme="@android:style/Theme.Material.NoActionBar" android:configChanges="colorMode|density|fontScale|keyboard|keyboardHidden|layoutDirection|locale|mcc|mnc|navigation|orientation|screenLayout|screenSize|smallestScreenSize|touchscreen|uiMode">' \
    '      <intent-filter>' \
    '        <action android:name="android.intent.action.MAIN" />' \
    '        <category android:name="android.intent.category.LAUNCHER" />' \
    '      </intent-filter>' \
    '    </activity>' \
    '  </application>' \
    '</manifest>'
} > "$manifest"

# R8 keeps every name, so class names in errors and stack traces stay real,
# and the methods the runtime calls from native code.
printf '%s\n' \
  '-dontobfuscate' \
  '-keep interface com.tokamak.runtime.TokamakRuntime$Plugins { *; }' \
  '-keepclassmembers class * implements com.tokamak.runtime.TokamakRuntime$Plugins { *; }' \
  > "$app/tokamak-rules.pro"

gradle --no-daemon "${gradle_arguments[@]}" --project-dir "$project"
mkdir -p "$(dirname "$output")"
cp "$app/build/outputs/apk/$variant/app-$variant.apk" "$output"
