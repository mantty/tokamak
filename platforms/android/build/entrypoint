#!/usr/bin/env bash
set -euo pipefail

# The CLI runs the entrypoint from the pack root.
pack=$PWD

# The build tools of apps and of describing plugins. Coroutines are the version
# androidx.lifecycle brings, so plugins' coroutines add no code.
agp_version=8.7.3
kotlin_version=2.1.0
coroutines_version=1.9.0

# Describes the methods PLUGIN/android/Exports.kt exports into
# OUTPUT/description.json, with the dispatch that serves them,
# OUTPUT/Exports.generated.kt. A JVM unit test of the plugin, compiled with
# the plugin API and its dependencies, runs the registration and reflects on
# the methods it lists.
describe() {
  local plugin=$1 output=$2
  if [[ $# -ne 3 || $3 != android ]]; then
    echo "Android plugins run on android, not ${*:3}" >&2
    exit 2
  fi
  local sdk=${ANDROID_HOME:-${ANDROID_SDK_ROOT:-}}
  if ! command -v gradle > /dev/null || ! command -v java > /dev/null || [[ ! -d "$sdk/platforms" ]]; then
    echo "Describing an Android plugin needs Gradle, Java and the Android SDK" >&2
    exit 69
  fi
  # Global, for the exit trap.
  temporary=$(mktemp -d "${TMPDIR:-/tmp}/tokamak-describe.XXXXXX")
  trap 'rm -rf "$temporary"' EXIT
  local module=$temporary/plugin
  mkdir -p "$module"
  cat > "$temporary/settings.gradle" <<'EOF'
pluginManagement {
  repositories {
    google()
    mavenCentral()
    gradlePluginPortal()
  }
}
dependencyResolutionManagement {
  repositories {
    google()
    mavenCentral()
  }
}
rootProject.name = 'tokamak-describe'
include ':plugin'
EOF
  cat > "$temporary/build.gradle" <<EOF
plugins {
  id 'com.android.library' version '$agp_version' apply false
  id 'org.jetbrains.kotlin.android' version '$kotlin_version' apply false
}
EOF
  printf '%s\n' 'android.useAndroidX=true' > "$temporary/gradle.properties"
  cat > "$module/build.gradle" <<EOF
plugins {
  id 'com.android.library'
  id 'org.jetbrains.kotlin.android'
}

android {
  namespace 'tokamak.describe'
  compileSdk 35
  // The plugin's own files, so compiler errors name them.
  sourceSets {
    main.kotlin.srcDirs = ['$pack/native-shell/plugin', '$plugin/android']
    test.kotlin.srcDirs = ['$pack/describer']
  }
  defaultConfig {
    minSdk $(<"$pack/build/min-sdk")
  }
  compileOptions {
    sourceCompatibility JavaVersion.VERSION_17
    targetCompatibility JavaVersion.VERSION_17
  }
  testOptions {
    unitTests.returnDefaultValues = true
    unitTests.all {
      systemProperty 'tokamak.output', '$output'
      systemProperty 'tokamak.classes', layout.buildDirectory.dir('tmp/kotlin-classes/debug').get().asFile.path
      outputs.upToDateWhen { false }
    }
  }
}

kotlin {
  jvmToolchain(17)
  compilerOptions {
    freeCompilerArgs.add('-Xjvm-default=all')
  }
}

// The dispatch describing regenerates.
tasks.withType(org.jetbrains.kotlin.gradle.tasks.KotlinCompile).configureEach {
  exclude '**/Exports.generated.kt'
}

def manifest = new groovy.json.JsonSlurper().parse(file('$plugin/tokamak-plugin.json'))
dependencies {
  implementation 'org.jetbrains.kotlinx:kotlinx-coroutines-android:$coroutines_version'
  (manifest.platforms?.android?.dependencies ?: []).each { implementation it }
  testImplementation 'junit:junit:4.13.2'
  testImplementation 'org.jetbrains.kotlin:kotlin-reflect:$kotlin_version'
  // android.jar's org.json is stubs; the describer writes JSON with the reference implementation.
  testImplementation 'org.json:json:20250517'
}
EOF
  gradle --quiet --project-dir "$temporary" :plugin:testDebugUnitTest
  if [[ -f "$output/error" ]]; then
    cat "$output/error" >&2
    rm "$output/error"
    exit 1
  fi
}
if [[ $# -ge 1 && $1 == describe ]]; then
  describe "${@:2}"
  exit
fi

if [[ $# -ne 3 || $1 != build ]]; then
  echo "usage: entrypoint build INPUT OUTPUT | entrypoint describe PLUGIN OUTPUT android" >&2
  exit 2
fi

input=$2
output=$3
metadata=$input/metadata
app_name=$(cat "$metadata/app-name")
host=$(cat "$metadata/host")
identifier=$(cat "$metadata/identifier")
version=1.0
if [[ -f "$metadata/version" ]]; then
  version=$(cat "$metadata/version")
fi
dev_endpoint=
dev_session_token=
if [[ -f "$metadata/dev-endpoint" ]]; then
  dev_endpoint=$(cat "$metadata/dev-endpoint")
  dev_session_token=$(cat "$metadata/dev-session-token")
fi
# Development builds are debug builds. Other builds are release builds,
# which R8 shrinks and a configured keystore signs; without one, the debug
# key signs them so they install for testing. Gradle reads the keystore
# settings from the environment.
variant=release
task=Release
if [[ -n "$dev_endpoint" ]]; then
  variant=debug
  task=Debug
fi
signing=debug
if [[ "$variant" == release && -n "${TOKAMAK_ANDROID_KEYSTORE:-}" ]]; then
  if [[ ! -f "$TOKAMAK_ANDROID_KEYSTORE" ]]; then
    echo "Android keystore is missing: $TOKAMAK_ANDROID_KEYSTORE" >&2
    exit 1
  fi
  if [[ -z "${TOKAMAK_ANDROID_KEY_ALIAS:-}" || -z "${TOKAMAK_ANDROID_KEYSTORE_PASSWORD:-}" ]]; then
    echo "an Android keystore needs key-alias and keystore-password" >&2
    exit 1
  fi
  signing=release
elif [[ "$variant" == release && -n "${TOKAMAK_ANDROID_KEY_ALIAS:-}${TOKAMAK_ANDROID_KEYSTORE_PASSWORD:-}${TOKAMAK_ANDROID_KEY_PASSWORD:-}" ]]; then
  echo "Android key-alias and passwords need a keystore" >&2
  exit 1
fi
user_manifest=
if [[ -n "${TOKAMAK_ANDROID_MANIFEST:-}" ]]; then
  user_manifest=$TOKAMAK_ANDROID_MANIFEST
  if [[ ! -f "$user_manifest" ]]; then
    echo "Android manifest file is missing: $user_manifest" >&2
    exit 1
  fi
fi
icon=${TOKAMAK_ANDROID_ICON:-}
if [[ -n "$icon" && ! -d "$icon" ]]; then
  echo "android.icon must be an Android res directory: $icon" >&2
  exit 1
fi
project=$(dirname "$output")/.tokamak
app=$project/app
native=$app/src/main/jniLibs/arm64-v8a
assets=$app/src/main/assets/app
kotlin=$app/src/main/kotlin/com/tokamak/runtime
plugin_api=$project/tokamak-plugin
plugin_modules=$project/plugins
# The oldest Android API level the app supports.
min_sdk=$(<"$pack/build/min-sdk")

# The Android NDK's compiler, which links the runtime into the app.
android_linker() {
  local ndk=${ANDROID_NDK_HOME:-}
  local sdk_root=${ANDROID_HOME:-${ANDROID_SDK_ROOT:-}}
  if [[ ! -d "$ndk" && -n "$sdk_root" && -d "$sdk_root/ndk" ]]; then
    ndk=$(find "$sdk_root/ndk" -mindepth 1 -maxdepth 1 -type d -print | sort | tail -n 1)
  fi
  local compiler
  for compiler in "$ndk"/toolchains/llvm/prebuilt/*/bin/aarch64-linux-android"$min_sdk"-clang; do
    if [[ -x "$compiler" ]]; then
      printf '%s' "$compiler"
      return
    fi
  done
  echo "Android builds link the tokamak runtime with the Android NDK, which is not installed." >&2
  echo "Install it with Android Studio's SDK Manager (SDK Tools > NDK) or \`sdkmanager \"ndk;29.0.14206865\"\`, or set ANDROID_NDK_HOME." >&2
  exit 1
}

# Link the runtime into libtokamak.so, exporting the JNI functions and the
# entry points of the runtime parts the app links.
link_runtime() {
  local runtime=$pack/lib/TokamakRuntime
  local exports=$project/tokamak-exports.map
  local compiler libraries
  compiler=$(android_linker)
  {
    printf '{\n  global:\n    Java_*;\n'
    sed 's/.*/    &;/' "$metadata/exported-symbols"
    printf '  local:\n    *;\n};\n'
  } > "$exports"
  read -r -a libraries <<< "$(< "$runtime/link-libraries")"
  "$compiler" -shared -o "$native/libtokamak.so" \
    -Wl,-soname,libtokamak.so \
    -Wl,--whole-archive "$runtime/libtokamak.a" -Wl,--no-whole-archive \
    -Wl,--version-script="$exports" \
    -Wl,--gc-sections -Wl,--as-needed -Wl,--eh-frame-hdr \
    -Wl,-z,noexecstack -Wl,-z,relro,-z,now -Wl,-z,max-page-size=16384 \
    -Wl,--strip-all \
    "${libraries[@]}"
}

# The signing configuration for a keystore that signs release builds.
release_signing() {
  if [[ "$signing" != release ]]; then
    return
  fi
  cat <<'EOF'
  signingConfigs {
    release {
      storeFile file(System.getenv('TOKAMAK_ANDROID_KEYSTORE'))
      storePassword System.getenv('TOKAMAK_ANDROID_KEYSTORE_PASSWORD')
      keyAlias System.getenv('TOKAMAK_ANDROID_KEY_ALIAS')
      keyPassword System.getenv('TOKAMAK_ANDROID_KEY_PASSWORD') ?: System.getenv('TOKAMAK_ANDROID_KEYSTORE_PASSWORD')
    }
  }

EOF
}

# The gateway's server certificate for the app host, with its key, in
# assets/tokamak-gateway.p12. The network security config trusts the
# certificate's authority for the app host alone, so the WebView verifies the
# gateway itself. Each build creates its own authority and discards the
# authority's key. The gateway's key ships in the app, which is safe only while
# the WebView sends the app host's traffic to no listener but the gateway. The
# keystore's password is public, so the keystore uses the algorithms every
# Android version reads, at one iteration, and the certificates outlive any app.
gateway_identity() {
  local keytool=keytool
  if [[ -n "${JAVA_HOME:-}" ]]; then
    keytool=$JAVA_HOME/bin/keytool
  fi
  if ! command -v "$keytool" > /dev/null; then
    echo "Android builds create the gateway certificate with keytool, which the JDK provides" >&2
    exit 69
  fi
  local resources=$app/src/main/res
  local keystore=(
    "$keytool"
    -J-Dkeystore.pkcs12.certProtectionAlgorithm=NONE
    -J-Dkeystore.pkcs12.keyProtectionAlgorithm=PBEWithSHA1AndDESede
    -J-Dkeystore.pkcs12.macAlgorithm=HmacPBESHA1
    -J-Dkeystore.pkcs12.keyPbeIterationCount=1
    -J-Dkeystore.pkcs12.macIterationCount=1
    -keystore "$app/src/main/assets/tokamak-gateway.p12" -storetype PKCS12 -storepass tokamak
  )
  local key=(-keyalg EC -groupname secp256r1 -sigalg SHA256withECDSA -validity 36500)
  mkdir -p "$resources/raw" "$resources/xml"
  "${keystore[@]}" -genkeypair -alias authority "${key[@]}" -dname 'CN=tokamak gateway' \
    -ext bc:c=ca:true,pathlen:0
  "${keystore[@]}" -genkeypair -alias gateway "${key[@]}" -dname "CN=$host" -signer authority \
    -ext "san=dns:$host" -ext eku=serverAuth -ext ku:c=digitalSignature
  "${keystore[@]}" -exportcert -alias authority -rfc -file "$resources/raw/tokamak_gateway_authority.pem"
  "${keystore[@]}" -delete -alias authority
  cat > "$resources/xml/tokamak_network_security_config.xml" <<EOF
<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
  <base-config cleartextTrafficPermitted="false" />
  <domain-config>
    <domain includeSubdomains="false">$(xml_escape "$host")</domain>
    <trust-anchors>
      <certificates src="@raw/tokamak_gateway_authority" />
    </trust-anchors>
  </domain-config>
</network-security-config>
EOF
}

xml_escape() {
  printf '%s' "$1" |
    sed -e 's/&/\&amp;/g' \
      -e 's/</\&lt;/g' \
      -e 's/>/\&gt;/g' \
      -e 's/"/\&quot;/g' \
      -e "s/'/\&apos;/g"
}

rm -rf "$app/src/main/assets" "$app/src/main/jniLibs" "$app/src/main/kotlin" "$app/src/main/res" "$app/user" "$plugin_api" "$plugin_modules" "$output"
mkdir -p "$native" "$assets" "$kotlin" "$app/src/main/res" "$plugin_api/src/main/kotlin"
cp -R "$input/app/." "$assets/"
link_runtime
cp -R "$pack/native-shell/app/." "$kotlin/"
cp -R "$pack/native-shell/plugin/." "$plugin_api/src/main/kotlin/"
cat > "$plugin_api/build.gradle" <<EOF
plugins {
  id 'com.android.library'
  id 'org.jetbrains.kotlin.android'
}

android {
  namespace 'com.tokamak.runtime.plugin'
}

dependencies {
  api 'org.jetbrains.kotlinx:kotlinx-coroutines-android:$coroutines_version'
}
EOF

has_icon=false
if [[ -n "$icon" ]]; then
  cp -R "$icon/." "$app/src/main/res/"
  shopt -s nullglob
  launcher_resources=("$app/src/main/res"/mipmap*/ic_launcher.*)
  if (( ${#launcher_resources[@]} == 0 )); then
    echo "Android icon resources must define mipmap/ic_launcher" >&2
    exit 1
  fi
  has_icon=true
fi
gateway_identity

# Each plugin is a library module, so its manifest merges below the app's and
# its dependencies stay its own. Its class is a Kotlin class name in a package,
# which the registry creates, and its dependencies are Maven coordinates.
kotlin_class='^[A-Za-z_][A-Za-z0-9_]*(\.[A-Za-z_][A-Za-z0-9_]*)+$'
maven_coordinate='^[A-Za-z0-9._-]+:[A-Za-z0-9._-]+:[A-Za-z0-9._-]+$'
registry=$kotlin/TokamakPluginRegistry.kt
printf '%s\n\n%s\n%s\n' 'package com.tokamak.runtime' 'internal fun tokamakPlugins(app: TokamakApplication): List<TokamakPlugin> =' '    listOf(' > "$registry"
shopt -s nullglob
raw_names=" "
for plugin in "$input/plugins"/*/; do
  plugin_id=$(basename "$plugin")
  class=$(cat "$plugin/class" 2>/dev/null || true)
  if [[ ! "$class" =~ $kotlin_class ]]; then
    echo "plugin '$plugin_id' has invalid android class '$class'" >&2
    exit 1
  fi
  # A plugin that exports methods runs behind the dispatch generated for it,
  # whose companion object converts its values for its host.
  if [[ -f "$plugin/native/Exports.kt" ]]; then
    printf '        %sDispatch(app.host("%s", %sDispatch)),\n' "$class" "$plugin_id" "$class" >> "$registry"
  else
    printf '        %s(app.host("%s")),\n' "$class" "$plugin_id" >> "$registry"
  fi
  module=$plugin_modules/$plugin_id
  mkdir -p "$module/src/main/kotlin"
  if [[ -d "$plugin/native" ]]; then
    while IFS= read -r -d '' source; do
      relative=${source#"$plugin/native/"}
      mkdir -p "$module/src/main/kotlin/$(dirname "$relative")"
      cp "$source" "$module/src/main/kotlin/$relative"
    done < <(find "$plugin/native" -name '*.kt' -print0)
  fi
  if [[ -f "$plugin/manifest" ]]; then
    cp "$plugin/manifest" "$module/src/main/AndroidManifest.xml"
  fi
  for resource in "$plugin/raw"/*; do
    [[ -f "$resource" ]] || continue
    name=${resource##*/}
    name=${name#*-}
    # Android names a raw resource without its extension, across every plugin.
    if [[ "$raw_names" == *" ${name%%.*} "* ]]; then
      echo "plugin '$plugin_id' raw resource '$name' has the name of another plugin resource" >&2
      exit 1
    fi
    raw_names+=" ${name%%.*} "
    mkdir -p "$module/src/main/res/raw"
    cp "$resource" "$module/src/main/res/raw/$name"
  done
  {
    printf '%s\n' 'plugins {' "  id 'com.android.library'" "  id 'org.jetbrains.kotlin.android'"
    printf '%s\n\n' '}'
    printf '%s\n' 'android {'
    printf "  namespace 'tokamak.plugins.%s'\n" "${plugin_id//-/_}"
    printf '%s\n\n' '}'
    printf '%s\n' 'dependencies {' "  implementation project(':tokamak-plugin')"
    for dependency in "$plugin/dependencies"/*; do
      coordinate=$(cat "$dependency")
      if [[ ! "$coordinate" =~ $maven_coordinate ]]; then
        echo "plugin '$plugin_id' has invalid android dependency '$coordinate'; use group:artifact:version" >&2
        exit 1
      fi
      printf "  implementation '%s'\n" "$coordinate"
    done
    printf '%s\n' '}'
  } > "$module/build.gradle"
done
printf '%s\n' '    )' >> "$registry"

mkdir -p "$project/app/src/main"
cat > "$project/settings.gradle" <<'EOF'
pluginManagement {
  repositories {
    google()
    mavenCentral()
    gradlePluginPortal()
  }
}
dependencyResolutionManagement {
  repositoriesMode.set(RepositoriesMode.FAIL_ON_PROJECT_REPOS)
  repositories {
    google()
    mavenCentral()
  }
}
rootProject.name = 'tokamak'
include ':app', ':tokamak-plugin'
EOF
for plugin in "$input/plugins"/*/; do
  printf "include ':plugins:%s'\n" "$(basename "$plugin")" >> "$project/settings.gradle"
done

cat > "$project/build.gradle" <<EOF
plugins {
  id 'com.android.application' version '$agp_version' apply false
  id 'com.android.library' version '$agp_version' apply false
  id 'org.jetbrains.kotlin.android' version '$kotlin_version' apply false
}

subprojects {
  plugins.withId('com.android.library') {
    android {
      compileSdk 35
      defaultConfig {
        minSdk $min_sdk
      }
      sourceSets {
        main {
          kotlin.srcDirs += 'src/main/kotlin'
        }
      }
      compileOptions {
        sourceCompatibility JavaVersion.VERSION_17
        targetCompatibility JavaVersion.VERSION_17
      }
    }
  }
  plugins.withId('org.jetbrains.kotlin.android') {
    kotlin {
      jvmToolchain(17)
      // Interface default methods compile into the interface, not into each
      // implementing class, which incremental builds do not recompile when a
      // Tokamak interface in another module gains or changes one.
      compilerOptions {
        freeCompilerArgs.add('-Xjvm-default=all')
      }
    }
  }
}
EOF

printf '%s\n' 'android.useAndroidX=true' > "$project/gradle.properties"
cat > "$project/app/build.gradle" <<EOF
plugins {
  id 'com.android.application'
  id 'org.jetbrains.kotlin.android'
}

android {
  namespace 'com.tokamak.runtime'
  compileSdk 35

  defaultConfig {
    applicationId '$identifier'
    minSdk $min_sdk
    targetSdk 35
    versionCode 1
    versionName providers.gradleProperty('tokamak.version').get()
  }

  androidResources {
    ignoreAssetsPattern = ''
  }

  sourceSets {
    main {
      kotlin.srcDirs += 'src/main/kotlin'
    }
  }

  compileOptions {
    sourceCompatibility JavaVersion.VERSION_17
    targetCompatibility JavaVersion.VERSION_17
  }

  lint {
    checkOnly 'NewApi'
    abortOnError true
    checkDependencies true
  }

$(release_signing)
  buildTypes {
    release {
      minifyEnabled true
      proguardFiles getDefaultProguardFile('proguard-android-optimize.txt'), 'tokamak-rules.pro'
      signingConfig signingConfigs.$signing
    }
  }
}

dependencies {
  implementation 'androidx.lifecycle:lifecycle-process:2.11.0'
  implementation 'androidx.webkit:webkit:1.12.1'
  implementation project(':tokamak-plugin')
EOF
for plugin in "$input/plugins"/*/; do
  printf "  implementation project(':plugins:%s')\n" "$(basename "$plugin")" >> "$project/app/build.gradle"
done
printf '%s\n' '}' >> "$project/app/build.gradle"

if [[ -n "$user_manifest" ]]; then
  mkdir -p "$app/user"
  cp "$user_manifest" "$app/user/AndroidManifest.xml"
  cat >> "$project/app/build.gradle" <<'EOF'

androidComponents {
  onVariants(selector().all()) { variant ->
    variant.sources.manifests.addStaticManifestFile(file('user/AndroidManifest.xml').path)
  }
}
EOF
fi

manifest=$app/src/main/AndroidManifest.xml
{
  printf '%s\n' \
    '<manifest xmlns:android="http://schemas.android.com/apk/res/android">' \
    '  <uses-permission android:name="android.permission.INTERNET" />'
  icon_attribute=
  if [[ "$has_icon" == true ]]; then
    icon_attribute=' android:icon="@mipmap/ic_launcher"'
  fi
  printf '  <application android:name=".TokamakApplication" android:label="%s"%s android:networkSecurityConfig="@xml/tokamak_network_security_config">\n' "$(xml_escape "$app_name")" "$icon_attribute"
  printf '    <meta-data android:name="tokamak.host" android:value="%s" />\n' "$host"
  if [[ -n "$dev_endpoint" ]]; then
    printf '    <meta-data android:name="tokamak.dev.endpoint" android:value="%s" />\n' "$dev_endpoint"
    printf '    <meta-data android:name="tokamak.dev.session-token" android:value="%s" />\n' "$dev_session_token"
  fi
  printf '%s\n' \
    '    <activity android:name=".TokamakActivity" android:exported="true" android:launchMode="singleTask" android:theme="@android:style/Theme.Material.NoActionBar" android:configChanges="colorMode|density|fontScale|keyboard|keyboardHidden|layoutDirection|locale|mcc|mnc|navigation|orientation|screenLayout|screenSize|smallestScreenSize|touchscreen|uiMode">' \
    '      <intent-filter>' \
    '        <action android:name="android.intent.action.MAIN" />' \
    '        <category android:name="android.intent.category.LAUNCHER" />' \
    '      </intent-filter>' \
    '    </activity>' \
    '  </application>' \
    '</manifest>'
} > "$manifest"

# R8 keeps every name, so class names in errors and stack traces stay real,
# and the methods the runtime calls from native code.
printf '%s\n' \
  '-dontobfuscate' \
  '-keep interface com.tokamak.runtime.TokamakRuntime$Plugins { *; }' \
  '-keepclassmembers class * implements com.tokamak.runtime.TokamakRuntime$Plugins { *; }' \
  > "$app/tokamak-rules.pro"

gradle --no-daemon "-Ptokamak.version=$version" ":app:lint$task" ":app:assemble$task" --project-dir "$project"
mkdir -p "$(dirname "$output")"
cp "$app/build/outputs/apk/$variant/app-$variant.apk" "$output"
