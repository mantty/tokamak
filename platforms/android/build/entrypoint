#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 3 || $1 != build ]]; then
  echo "usage: entrypoint build INPUT OUTPUT" >&2
  exit 2
fi

input=$2
output=$3
metadata=$input/metadata
app_name=$(cat "$metadata/app-name")
host=$(cat "$metadata/host")
platform=$(cat "$metadata/platform")
identifier=$(cat "$metadata/identifier")
version=1.0
if [[ -f "$metadata/version" ]]; then
  version=$(cat "$metadata/version")
fi
dev_endpoint=
dev_session_token=
if [[ -f "$metadata/dev-endpoint" ]]; then
  dev_endpoint=$(cat "$metadata/dev-endpoint")
fi
if [[ -f "$metadata/dev-session-token" ]]; then
  dev_session_token=$(cat "$metadata/dev-session-token")
fi
if [[ -n "$dev_endpoint" && -z "$dev_session_token" ]] || [[ -z "$dev_endpoint" && -n "$dev_session_token" ]]; then
  echo "development endpoint and session token must be provided together" >&2
  exit 1
fi
project=$(dirname "$output")/.tokamak
app=$project/app
native=$app/src/main/jniLibs/arm64-v8a
assets=$app/src/main/assets/app
kotlin=$app/src/main/kotlin/com/tokamak/runtime
plugins_root=$app/src/main/kotlin/tokamak/plugins
icons=$input/icons/$platform

xml_escape() {
  printf '%s' "$1" |
    sed -e 's/&/\&amp;/g' \
      -e 's/</\&lt;/g' \
      -e 's/>/\&gt;/g' \
      -e 's/"/\&quot;/g' \
      -e "s/'/\&apos;/g"
}

rm -rf "$app/src/main/assets" "$app/src/main/jniLibs" "$app/src/main/kotlin" "$app/src/main/res" "$output"
mkdir -p "$native" "$assets" "$kotlin" "$plugins_root" "$app/src/main/res"
cp -R "$input/app/." "$assets/"
cp "$input/runtime/libtokamak.so" "$native/libtokamak.so"
cp -R "$input/native-shell/." "$kotlin/"

has_icon=false
if [[ -d "$icons" ]]; then
  cp -R "$icons/." "$app/src/main/res/"
  shopt -s nullglob
  launcher_resources=("$app/src/main/res"/mipmap*/ic_launcher.*)
  if (( ${#launcher_resources[@]} == 0 )); then
    echo "Android icon resources must define mipmap/ic_launcher" >&2
    exit 1
  fi
  has_icon=true
fi

shopt -s nullglob
plugin_classes=()
for plugin in "$input/plugins"/*; do
  [[ -d "$plugin" ]] || continue
  plugin_id=$(basename "$plugin")
  plugin_classes+=("$(cat "$plugin/class")")
  plugin_sources=$plugins_root/$plugin_id
  mkdir -p "$plugin_sources"
  for source in "$plugin/sources"/*; do
    [[ -f "$source" ]] || continue
    case "$source" in
      *.kt)
        cp "$source" "$plugin_sources/$(basename "$source")"
        ;;
      *)
        echo "Android plugin source must be Kotlin: $source" >&2
        exit 1
        ;;
    esac
  done
done

mkdir -p "$project/app/src/main"
cat > "$project/settings.gradle" <<'EOF'
pluginManagement {
  repositories {
    google()
    mavenCentral()
    gradlePluginPortal()
  }
}
dependencyResolutionManagement {
  repositoriesMode.set(RepositoriesMode.FAIL_ON_PROJECT_REPOS)
  repositories {
    google()
    mavenCentral()
  }
}
rootProject.name = 'tokamak'
include ':app'
EOF

cat > "$project/build.gradle" <<'EOF'
plugins {
  id 'com.android.application' version '8.7.3' apply false
  id 'org.jetbrains.kotlin.android' version '2.1.0' apply false
}
EOF

printf '%s\n' 'android.useAndroidX=true' > "$project/gradle.properties"
cat > "$project/app/build.gradle" <<EOF
plugins {
  id 'com.android.application'
  id 'org.jetbrains.kotlin.android'
}

android {
  namespace 'com.tokamak.runtime'
  compileSdk 35

  defaultConfig {
    applicationId '$identifier'
    minSdk 31
    targetSdk 35
    versionCode 1
    versionName '$version'
  }

  androidResources {
    ignoreAssetsPattern = ''
  }

  sourceSets {
    main {
      kotlin.srcDirs += 'src/main/kotlin'
    }
  }

  compileOptions {
    sourceCompatibility JavaVersion.VERSION_17
    targetCompatibility JavaVersion.VERSION_17
  }
}

kotlin {
  jvmToolchain(17)
}

dependencies {
  implementation 'androidx.webkit:webkit:1.12.1'
}
EOF

registry=$kotlin/TokamakPluginRegistry.kt
{
  printf '%s\n\n' 'package com.tokamak.runtime'
  printf '%s\n\n' 'import android.app.Activity'
  printf '%s\n' 'internal fun tokamakPlugins(activity: Activity): List<TokamakPlugin> ='
  printf '%s\n' '    listOf('
  if ((${#plugin_classes[@]} > 0)); then
    for class in "${plugin_classes[@]}"; do
      printf '        %s(activity),\n' "$class"
    done
  fi
  printf '%s\n' '    )'
} > "$registry"

manifest=$app/src/main/AndroidManifest.xml
{
  printf '%s\n' '<manifest xmlns:android="http://schemas.android.com/apk/res/android">'
  printf '%s\n' '  <uses-permission android:name="android.permission.INTERNET" />'
  for plugin in "$input/plugins"/*; do
    [[ -d "$plugin" ]] || continue
    for permission in "$plugin/permissions"/*; do
      [[ -f "$permission" ]] || continue
      printf '  <uses-permission android:name="%s" />\n' "$(cat "$permission")"
    done
  done
  icon_attribute=
  if [[ "$has_icon" == true ]]; then
    icon_attribute=' android:icon="@mipmap/ic_launcher"'
  fi
  printf '  <application android:label="%s"%s android:usesCleartextTraffic="false">\n' "$(xml_escape "$app_name")" "$icon_attribute"
  printf '    <meta-data android:name="tokamak.host" android:value="%s" />\n' "$host"
  if [[ -n "$dev_endpoint" ]]; then
    printf '    <meta-data android:name="tokamak.dev.endpoint" android:value="%s" />\n' "$dev_endpoint"
    printf '    <meta-data android:name="tokamak.dev.session-token" android:value="%s" />\n' "$dev_session_token"
  fi
  printf '%s\n' '    <activity android:name=".TokamakActivity" android:exported="true" android:launchMode="singleTask" android:theme="@android:style/Theme.Material.NoActionBar" android:configChanges="colorMode|density|fontScale|keyboard|keyboardHidden|layoutDirection|locale|mcc|mnc|navigation|orientation|screenLayout|screenSize|smallestScreenSize|touchscreen|uiMode">'
  printf '%s\n' '      <intent-filter>'
  printf '%s\n' '        <action android:name="android.intent.action.MAIN" />'
  printf '%s\n' '        <category android:name="android.intent.category.LAUNCHER" />'
  printf '%s\n' '      </intent-filter>'
  printf '%s\n' '    </activity>'
  printf '%s\n' '  </application>'
  printf '%s\n' '</manifest>'
} > "$manifest"

gradle --no-daemon :app:assembleDebug --project-dir "$project"
mkdir -p "$(dirname "$output")"
cp "$app/build/outputs/apk/debug/app-debug.apk" "$output"
