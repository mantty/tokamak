#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 3 || "$1" != build ]]; then
  echo "usage: platform-pack build TARGET OUTPUT" >&2
  exit 2
fi

target=$2
output=$3
workspace=$PWD
build=$workspace/platforms/apple/build

case "$target" in
  macos-arm64) rust_target=aarch64-apple-darwin ;;
  macos-x64) rust_target=x86_64-apple-darwin ;;
  ios-arm64) rust_target=aarch64-apple-ios ;;
  ios-simulator-arm64) rust_target=aarch64-apple-ios-sim ;;
  ios-simulator-x64) rust_target=x86_64-apple-ios ;;
  *)
    echo "unsupported Apple target: $target" >&2
    exit 1
    ;;
esac
case "$target" in
  macos-*)
    MACOSX_DEPLOYMENT_TARGET=$(<"$build/macos-deployment-target")
    export MACOSX_DEPLOYMENT_TARGET
    ;;
  *)
    IPHONEOS_DEPLOYMENT_TARGET=$(<"$build/ios-deployment-target")
    export IPHONEOS_DEPLOYMENT_TARGET IPHONESIMULATOR_DEPLOYMENT_TARGET=$IPHONEOS_DEPLOYMENT_TARGET
    ;;
esac

framework=$output/frameworks/TokamakRuntime.framework
rm -rf "$output"
mkdir -p \
  "$output/build" \
  "$framework/Headers" \
  "$framework/Modules" \
  "$output/native-shell" \
  "$output/tools"

for host_target in aarch64-apple-darwin x86_64-apple-darwin; do
  cargo build \
    --package tokamak-apple-signing \
    --release \
    --target "$host_target"
done

lipo -create \
  "$workspace/target/aarch64-apple-darwin/release/tokamak-apple-signing" \
  "$workspace/target/x86_64-apple-darwin/release/tokamak-apple-signing" \
  -output "$output/tools/tokamak-apple-signing"

cargo rustc \
  --package tokamak \
  --release \
  --target "$rust_target" \
  --features native \
  --lib \
  --crate-type staticlib

library="$workspace/target/$rust_target/release/libtokamak.a"
if [[ ! -f "$library" ]]; then
  echo "tokamak runtime library was not produced: $library" >&2
  exit 1
fi

cp "$library" "$framework/TokamakRuntime"
cp "$workspace/platforms/apple/source/TokamakRuntime.h" "$framework/Headers/TokamakRuntime.h"
cp "$workspace/platforms/apple/source/module.modulemap" "$framework/Modules/module.modulemap"
cp "$workspace/platforms/apple/source/"*.swift "$output/native-shell/"
cp "$build/entrypoint" "$build"/*-deployment-target "$output/build/"
