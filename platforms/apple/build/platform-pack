#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 3 || "$1" != build ]]; then
  echo "usage: platform-pack build TARGET OUTPUT" >&2
  exit 2
fi

target=$2
output=$3
workspace=$PWD
# Where Cargo builds, which `cargo run -p xtask -- platform-pack` passes.
target_dir=${CARGO_TARGET_DIR:?run this recipe through cargo run -p xtask -- platform-pack}
build=$workspace/platforms/apple/build

case "$target" in
  macos-arm64) rust_target=aarch64-apple-darwin ;;
  macos-x64) rust_target=x86_64-apple-darwin ;;
  ios-arm64) rust_target=aarch64-apple-ios ;;
  ios-simulator-arm64) rust_target=aarch64-apple-ios-sim ;;
  ios-simulator-x64) rust_target=x86_64-apple-ios ;;
  *)
    echo "unsupported Apple target: $target" >&2
    exit 1
    ;;
esac
case "$target" in
  macos-*)
    MACOSX_DEPLOYMENT_TARGET=$(<"$build/macos-deployment-target")
    export MACOSX_DEPLOYMENT_TARGET
    ;;
  *)
    IPHONEOS_DEPLOYMENT_TARGET=$(<"$build/ios-deployment-target")
    export IPHONEOS_DEPLOYMENT_TARGET IPHONESIMULATOR_DEPLOYMENT_TARGET=$IPHONEOS_DEPLOYMENT_TARGET
    ;;
esac

rm -rf "$output"
mkdir -p \
  "$output/build" \
  "$output/frameworks" \
  "$output/native-shell" \
  "$output/plugin-api" \
  "$output/tools"

for host_target in aarch64-apple-darwin x86_64-apple-darwin; do
  cargo build \
    --package tokamak-apple-signing \
    --release \
    --target "$host_target"
done

lipo -create \
  "$target_dir/aarch64-apple-darwin/release/tokamak-apple-signing" \
  "$target_dir/x86_64-apple-darwin/release/tokamak-apple-signing" \
  -output "$output/tools/tokamak-apple-signing"

describer=(swift build --package-path "$workspace/platforms/apple/describer"
  --scratch-path "$target_dir/tokamak-swift-describe" --configuration release --arch arm64 --arch x86_64)
"${describer[@]}"
cp "$("${describer[@]}" --show-bin-path)/tokamak-swift-describe" "$output/tools/"

cargo rustc \
  --package tokamak \
  --release \
  --target "$rust_target" \
  --features native \
  --lib \
  --crate-type staticlib

library="$target_dir/$rust_target/release/libtokamak.a"
if [[ ! -f "$library" ]]; then
  echo "tokamak runtime library was not produced: $library" >&2
  exit 1
fi

# The runtime is a static library that apps link as a binary package target.
headers=$(mktemp -d "${TMPDIR:-/tmp}/tokamak-headers.XXXXXX")
trap 'rm -rf "$headers"' EXIT
cp "$workspace/platforms/apple/source/TokamakRuntime.h" "$workspace/platforms/apple/source/module.modulemap" "$headers/"
xcodebuild -create-xcframework -library "$library" -headers "$headers" \
  -output "$output/frameworks/TokamakRuntime.xcframework" > /dev/null
cp "$workspace/platforms/apple/source/"*.swift "$output/native-shell/"
# The plugin API apps build plugins against.
plugin_api=$workspace/plugins/core/apple/TokamakPlugin
mkdir "$output/plugin-api/TokamakPlugin"
cp -R "$plugin_api/Package.swift" "$plugin_api/Sources" "$output/plugin-api/TokamakPlugin/"
cp "$build/entrypoint" "$build"/*-deployment-target "$output/build/"
