#!/usr/bin/env bash
set -euo pipefail

# The CLI runs the entrypoint from the pack root.
pack=$PWD
apple_tool=$pack/tools/tokamak-apple-signing
if [[ ! -x "$apple_tool" ]]; then
  echo "Apple platform pack is missing its Apple helper: $apple_tool" >&2
  exit 1
fi
if [[ $# -eq 1 && $1 == certs ]]; then
  exec "$apple_tool" inventory
fi

# Describes the methods PLUGIN/apple/Exports.swift exports on each PLATFORM
# into OUTPUT/description.json, with the dispatch that serves them,
# OUTPUT/Exports.generated.swift. The compiler's symbol graph of the plugin,
# built with the shell for each platform, gives the methods' types.
describe() {
  local plugin=$1 output=$2
  shift 2
  if ! xcrun --sdk iphonesimulator --show-sdk-path > /dev/null 2>&1; then
    echo "Describing an Apple plugin needs Xcode" >&2
    exit 69
  fi
  # Global, for the exit trap.
  temporary=$(mktemp -d "${TMPDIR:-/tmp}/tokamak-describe.XXXXXX")
  trap 'rm -rf "$temporary"' EXIT
  printf '%s\n' 'func tokamakPlugins(app: TokamakApp) -> [any TokamakPlugin] { [] }' > "$temporary/registry.swift"
  local sources=("$pack/native-shell"/*.swift "$temporary/registry.swift") source
  while IFS= read -r -d '' source; do
    [[ ${source##*/} == Exports.generated.swift ]] || sources+=("$source")
  done < <(find "$plugin/apple" -name '*.swift' -print0 | sort -z)
  local graphs=() compiles=() platform sdk triple
  for platform in "$@"; do
    case "$platform" in
      ios)
        sdk=iphonesimulator
        triple=$(uname -m)-apple-ios$(<"$pack/build/ios-deployment-target")-simulator
        ;;
      macos)
        sdk=macosx
        triple=$(uname -m)-apple-macos$(<"$pack/build/macos-deployment-target")
        ;;
      *)
        echo "Apple plugins run on ios and macos, not $platform" >&2
        exit 2
        ;;
    esac
    mkdir "$temporary/$platform"
    # The platforms compile at once, each into its own log.
    xcrun --sdk "$sdk" swiftc -emit-module -module-name TokamakDescribed -swift-version 5 \
      -target "$triple" -F "$pack/frameworks" -module-cache-path "$temporary/cache" \
      -emit-module-path "$temporary/$platform/TokamakDescribed.swiftmodule" \
      -emit-symbol-graph -emit-symbol-graph-dir "$temporary/$platform" \
      -symbol-graph-minimum-access-level private "${sources[@]}" > "$temporary/$platform.log" 2>&1 &
    compiles+=("$!")
    graphs+=("$platform=$temporary/$platform/TokamakDescribed.symbols.json")
  done
  # The platforms report the same diagnostics, so only the first failure's
  # show, or else the first platform's warnings.
  local platforms=("$@") index failed=
  for index in "${!compiles[@]}"; do
    if ! wait "${compiles[index]}" && [[ -z $failed ]]; then
      failed=$index
    fi
  done
  cat "$temporary/${platforms[${failed:-0}]}.log" >&2
  [[ -z $failed ]] || exit 1
  "$pack/tools/tokamak-swift-describe" "$plugin/apple/Exports.swift" "$output" "${graphs[@]}"
}
if [[ $# -ge 4 && $1 == describe ]]; then
  describe "${@:2}"
  exit
fi

if [[ $# -ne 3 || $1 != build ]]; then
  echo "usage: entrypoint build INPUT OUTPUT | entrypoint describe PLUGIN OUTPUT PLATFORM... | entrypoint certs" >&2
  exit 2
fi

input=$2
output=$3
metadata=$input/metadata
app_slug=$(cat "$metadata/app-slug")
identifier=$(cat "$metadata/identifier")
platform=$(cat "$metadata/platform")
target=$(cat "$metadata/target")
project_dir=$(cat "$metadata/project-dir")
minimum=$(<"$pack/build/$platform-deployment-target")
output_parent=$(dirname "$output")
module_cache=$output_parent/.tokamak/module-cache
temporary=$(mktemp -d "${TMPDIR:-/tmp}/tokamak-apple.XXXXXX")
trap 'rm -rf "$temporary"' EXIT

case "$target" in
  macos-arm64)
    sdk=macosx
    triple=arm64-apple-macos$minimum
    ;;
  macos-x64)
    sdk=macosx
    triple=x86_64-apple-macos$minimum
    ;;
  ios-arm64)
    sdk=iphoneos
    triple=arm64-apple-ios$minimum
    ;;
  ios-simulator-arm64)
    sdk=iphonesimulator
    triple=arm64-apple-ios$minimum-simulator
    ;;
  ios-simulator-x64)
    sdk=iphonesimulator
    triple=x86_64-apple-ios$minimum-simulator
    ;;
  *)
    echo "unsupported Apple target: $target" >&2
    exit 1
    ;;
esac

bundle=$output
if [[ "$platform" == macos ]]; then
  contents=$bundle/Contents
  executable_dir=$contents/MacOS
  resources_dir=$contents/Resources
  app_dir=$resources_dir/app
  icon=${TOKAMAK_MACOS_ICON:-}
  app_files=("${TOKAMAK_MACOS_PLIST:-}" "${TOKAMAK_MACOS_ENTITLEMENTS:-}")
else
  contents=$bundle
  executable_dir=$bundle
  resources_dir=$bundle
  app_dir=$bundle/app
  icon=${TOKAMAK_IOS_ICON:-}
  app_files=("${TOKAMAK_IOS_PLIST:-}" "${TOKAMAK_IOS_ENTITLEMENTS:-}")
fi
if [[ -n "$icon" && ! ( -d "$icon" && "$icon" == *.[iI][cC][oO][nN] ) ]]; then
  echo "$platform.icon must be an Icon Composer .icon package: $icon" >&2
  exit 1
fi
icon_info_plist=$output_parent/.tokamak/$(basename "$output").icon-info.plist

write_plist() {
  plist_args=(plist --input "$input" --output "$temporary/Info.plist")
  if [[ -n "$icon" ]]; then
    plist_args+=(--icon-info-plist "$icon_info_plist")
  fi
  "$apple_tool" "${plist_args[@]}"
  cp "$temporary/Info.plist" "$contents/Info.plist"
}

sign_bundle() {
  if [[ "$sdk" == iphonesimulator ]]; then
    codesign --force --timestamp=none --sign - "$bundle"
    return
  fi
  signing_args=(
    sign
    --platform "$platform"
    --project "$project_dir"
    --bundle "$bundle"
    --bundle-id "$identifier"
  )
  if [[ "$platform" == ios && -f "$metadata/device-id" ]]; then
    signing_args+=(--device-id "$(cat "$metadata/device-id")")
  fi
  "$apple_tool" "${signing_args[@]}"
}

# The bundle is reused while everything it is built from, apart from the
# Worker's environment and the signing settings, is unchanged.
bundle_key_file=$output_parent/.tokamak/$(basename "$output").input-key
key_files=("$input" "$pack")
for key_file in "$icon" "${app_files[@]}"; do
  if [[ -n "$key_file" ]]; then
    key_files+=("$key_file")
  fi
done
bundle_key=$(
  {
    find -L "${key_files[@]}" -type f ! -path "$input/app/worker-environment.json" -print0 |
      LC_ALL=C sort -z | xargs -0 shasum -a 256
    env | LC_ALL=C sort | sed -n '/^TOKAMAK_/p' |
      sed '/^TOKAMAK_IOS_TEAM_ID=/d; /^TOKAMAK_IOS_SIGNING_IDENTITY=/d; /^TOKAMAK_IOS_PROVISIONING_PROFILE=/d; /^TOKAMAK_MACOS_TEAM_ID=/d; /^TOKAMAK_IOS_BUILD_NUMBER=/d; /^TOKAMAK_MACOS_BUILD_NUMBER=/d'
    printf '%s\n' "${DEVELOPER_DIR:-}" "$PATH"
    xcodebuild -version
  } | shasum -a 256 | cut -d ' ' -f 1
)
if [[ -d "$bundle" && -f "$bundle_key_file" && $(cat "$bundle_key_file") == "$bundle_key" && ( -z "$icon" || -f "$icon_info_plist" ) ]]; then
  write_plist
  cp "$input/app/worker-environment.json" "$app_dir/worker-environment.json"
  sign_bundle
  exit 0
fi

rm -f "$bundle_key_file" "$icon_info_plist"
rm -rf "$bundle"
mkdir -p "$executable_dir" "$app_dir" "$module_cache"
cp -R "$input/app/." "$app_dir/"

if [[ -n "$icon" ]]; then
  if [[ "$platform" == macos ]]; then
    icon_targets=(--target-device mac)
  else
    icon_targets=(--target-device iphone --target-device ipad)
  fi
  # actool names the app icon after its package.
  cp -R "$icon" "$temporary/AppIcon.icon"
  xcrun --sdk "$sdk" actool \
    --compile "$resources_dir" \
    --platform "$sdk" \
    --minimum-deployment-target "$minimum" \
    --app-icon AppIcon \
    "${icon_targets[@]}" \
    --output-partial-info-plist "$icon_info_plist" \
    --output-format human-readable-text \
    "$temporary/AppIcon.icon"
fi

shopt -s nullglob
swift_sources=()
for source in "$pack/native-shell"/*.swift; do
  [[ -f "$source" ]] || continue
  swift_sources+=("$source")
done

if [[ ! -f "$pack/native-shell/TokamakShell.swift" ]]; then
  echo "Apple native shell source is missing: $pack/native-shell/TokamakShell.swift" >&2
  exit 1
fi

# A plugin's class is a Swift type name, which the registry creates, and its
# sources are the Swift files in its native directory.
swift_type='^[A-Za-z_][A-Za-z0-9_]*(\.[A-Za-z_][A-Za-z0-9_]*)*$'
# Swift requires unique file names in a module, so a plugin's source
# <directory>/<name> compiles as <plugin>-<directory>-<name>.
plugin_sources=$temporary/plugin-sources
mkdir "$plugin_sources"
# A plugin's compilation conditions start with its id in capitals, such as
# LOCATION_ for location, as every plugin compiles into one module.
compilation_conditions=()
registry=$temporary/TokamakPluginRegistry.swift
printf '%s\n\n%s\n%s\n' 'import Foundation' 'func tokamakPlugins(app: TokamakApp) -> [any TokamakPlugin] {' '  [' > "$registry"
for plugin in "$input/plugins"/*/; do
  plugin_id=$(basename "$plugin")
  class=$(cat "$plugin/class" 2>/dev/null || true)
  if [[ ! "$class" =~ $swift_type ]]; then
    echo "plugin '$plugin_id' has invalid $platform class '$class'" >&2
    exit 1
  fi
  printf '    %s(host: TokamakHost(app: app, plugin: "%s")),\n' "$class" "$plugin_id" >> "$registry"
  condition_prefix=$(printf '%s' "$plugin_id" | tr 'a-z-' 'A-Z_')_
  for condition_file in "$plugin/compilation-conditions"/*; do
    condition=$(<"$condition_file")
    if [[ ! "$condition" =~ ^${condition_prefix}[A-Za-z0-9_]+$ ]]; then
      echo "plugin '$plugin_id' has compilation condition '$condition', which must be $condition_prefix followed by letters, digits or underscores" >&2
      exit 1
    fi
    compilation_conditions+=(-D "$condition")
  done
  [[ -d "$plugin/native" ]] || continue
  while IFS= read -r -d '' source; do
    relative=${source#"$plugin/native/"}
    named=$plugin_sources/$plugin_id-${relative//\//-}
    if [[ -e "$named" ]]; then
      echo "plugin '$plugin_id' source $relative stages as ${named##*/}, as another source does; rename one" >&2
      exit 1
    fi
    cp "$source" "$named"
    swift_sources+=("$named")
  done < <(find "$plugin/native" -name '*.swift' -print0 | sort -z)
done
printf '%s\n' '  ]' '}' >> "$registry"

# The executable exports only the entry points of the runtime parts the app
# links.
exported_symbols=$temporary/exported-symbols
sed 's/^/_/' "$metadata/exported-symbols" > "$exported_symbols"
swift_args=(
  "${swift_sources[@]}"
  "$registry"
  -target "$triple"
  -swift-version 5
  -Osize
  -whole-module-optimization
  -module-cache-path "$module_cache"
  -F "$pack/frameworks"
  -framework TokamakRuntime
  -framework CoreFoundation
  -lc++
  -lresolv
  -Xlinker -dead_strip
  -Xlinker -exported_symbols_list -Xlinker "$exported_symbols"
)
# Bash 3.2 cannot expand an empty array under set -u.
if [[ ${#compilation_conditions[@]} -gt 0 ]]; then
  swift_args+=("${compilation_conditions[@]}")
fi

# Simulator builds embed their entitlements in __TEXT,__entitlements, where
# the simulator reads them.
if [[ "$sdk" == iphonesimulator ]]; then
  simulator_entitlements=$temporary/simulator.entitlements
  "$apple_tool" simulator-entitlements --identifier "$identifier" --output "$simulator_entitlements"
  swift_args+=(-Xlinker -sectcreate -Xlinker __TEXT -Xlinker __entitlements -Xlinker "$simulator_entitlements")
fi

xcrun --sdk "$sdk" swiftc "${swift_args[@]}" -o "$executable_dir/$app_slug"
# Local symbols go; the exported entry points of linked parts stay.
xcrun --sdk "$sdk" strip -x "$executable_dir/$app_slug"

write_plist

# Plugins' resources go in the bundle's resources directory, where the system
# finds files such as notification sounds by name.
for resource in "$input/plugins"/*/resources/*; do
  [[ -f "$resource" ]] || continue
  name=${resource##*/}
  name=${name#*-}
  if [[ -e "$resources_dir/$name" ]]; then
    echo "plugin resource '$name' would replace a file in the app bundle" >&2
    exit 1
  fi
  cp "$resource" "$resources_dir/$name"
done

sign_bundle
mkdir -p "$(dirname "$bundle_key_file")"
printf '%s' "$bundle_key" > "$bundle_key_file"
