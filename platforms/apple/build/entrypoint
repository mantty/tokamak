#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 3 || $1 != build ]]; then
  echo "usage: entrypoint build INPUT OUTPUT" >&2
  exit 2
fi

input=$2
output=$3
metadata=$input/metadata
native_shell=$input/native-shell
framework_root=$input/runtime/frameworks
app_slug=$(cat "$metadata/app-slug")
identifier=$(cat "$metadata/identifier")
platform=$(cat "$metadata/platform")
target=$(cat "$metadata/target")
project_dir=$(cat "$metadata/project-dir")
output_parent=$(dirname "$output")
module_cache=$output_parent/.tokamak/module-cache
temporary=$(mktemp -d "${TMPDIR:-/tmp}/tokamak-apple.XXXXXX")
trap 'rm -rf "$temporary"' EXIT
apple_tool=$PWD/tools/tokamak-apple-signing
if [[ ! -x "$apple_tool" ]]; then
  echo "Apple platform pack is missing its Apple helper: $apple_tool" >&2
  exit 1
fi

case "$target" in
  macos-arm64)
    sdk=macosx
    triple=arm64-apple-macos14.0
    ;;
  macos-x64)
    sdk=macosx
    triple=x86_64-apple-macos14.0
    ;;
  ios-arm64)
    sdk=iphoneos
    triple=arm64-apple-ios17.0
    ;;
  ios-simulator-arm64)
    sdk=iphonesimulator
    triple=arm64-apple-ios17.0-simulator
    ;;
  ios-simulator-x64)
    sdk=iphonesimulator
    triple=x86_64-apple-ios17.0-simulator
    ;;
  *)
    echo "unsupported Apple target: $target" >&2
    exit 1
    ;;
esac

bundle=$output
if [[ "$platform" == macos ]]; then
  contents=$bundle/Contents
  executable_dir=$contents/MacOS
  app_dir=$contents/Resources/app
else
  contents=$bundle
  executable_dir=$bundle
  app_dir=$bundle/app
fi
icons=$input/icons/$platform
icon_info_plist=$output_parent/.tokamak/$(basename "$output").icon-info.plist

write_plist() {
  plist_args=(plist --input "$input" --output "$temporary/Info.plist")
  if [[ -d "$icons/AppIcon.icon" ]]; then
    plist_args+=(--icon-info-plist "$icon_info_plist")
  fi
  "$apple_tool" "${plist_args[@]}"
  cp "$temporary/Info.plist" "$contents/Info.plist"
}

sign_bundle() {
  if [[ "$sdk" == iphonesimulator ]]; then
    codesign --force --timestamp=none --sign - "$bundle"
    return
  fi
  signing_args=(
    sign
    --platform "$platform"
    --project "$project_dir"
    --bundle "$bundle"
    --bundle-id "$identifier"
  )
  if [[ "$platform" == ios && -f "$metadata/device-id" ]]; then
    signing_args+=(--device-id "$(cat "$metadata/device-id")")
  fi
  "$apple_tool" "${signing_args[@]}"
}

bundle_key_file=$output_parent/.tokamak/$(basename "$output").input-key
if [[ -f "$metadata/input-key" ]]; then
  case "$platform" in
    ios) app_files=("${TOKAMAK_IOS_PLIST:-}" "${TOKAMAK_IOS_ENTITLEMENTS:-}") ;;
    macos) app_files=("${TOKAMAK_MACOS_PLIST:-}" "${TOKAMAK_MACOS_ENTITLEMENTS:-}") ;;
  esac
  bundle_key=$(
    {
      cat "$metadata/input-key"
      shasum -a 256 "$0" "$apple_tool"
      for app_file in "${app_files[@]}"; do
        if [[ -n "$app_file" ]]; then
          shasum -a 256 "$app_file"
        fi
      done
      env | LC_ALL=C sort | sed -n '/^TOKAMAK_/p' |
        sed '/^TOKAMAK_IOS_TEAM_ID=/d; /^TOKAMAK_IOS_SIGNING_IDENTITY=/d; /^TOKAMAK_IOS_PROVISIONING_PROFILE=/d; /^TOKAMAK_MACOS_TEAM_ID=/d; /^TOKAMAK_IOS_BUILD_NUMBER=/d; /^TOKAMAK_MACOS_BUILD_NUMBER=/d'
      printf '%s\n' "${DEVELOPER_DIR:-}" "$PATH"
      xcodebuild -version
    } | shasum -a 256 | cut -d ' ' -f 1
  )
  if [[ -d "$bundle" && -f "$bundle_key_file" && $(cat "$bundle_key_file") == "$bundle_key" && ( ! -d "$icons/AppIcon.icon" || -f "$icon_info_plist" ) ]]; then
    write_plist
    cp "$input/app/worker-environment.json" "$app_dir/worker-environment.json"
    sign_bundle
    exit 0
  fi
fi

rm -f "$bundle_key_file" "$icon_info_plist"
rm -rf "$bundle"
mkdir -p "$executable_dir" "$app_dir" "$module_cache"
cp -R "$input/app/." "$app_dir/"

if [[ -d "$icons/AppIcon.icon" ]]; then
  if [[ "$platform" == macos ]]; then
    icon_output=$contents/Resources
    icon_minimum=14.0
    icon_targets=(--target-device mac)
  else
    icon_output=$bundle
    icon_minimum=17.0
    icon_targets=(--target-device iphone --target-device ipad)
  fi
  xcrun --sdk "$sdk" actool \
    --compile "$icon_output" \
    --platform "$sdk" \
    --minimum-deployment-target "$icon_minimum" \
    --app-icon AppIcon \
    "${icon_targets[@]}" \
    --output-partial-info-plist "$icon_info_plist" \
    --output-format human-readable-text \
    "$icons/AppIcon.icon"
fi

shopt -s nullglob
swift_sources=()
for source in "$native_shell"/*.swift; do
  [[ -f "$source" ]] || continue
  swift_sources+=("$source")
done

if [[ ! -f "$native_shell/TokamakShell.swift" ]]; then
  echo "Apple native shell source is missing: $native_shell/TokamakShell.swift" >&2
  exit 1
fi

# A plugin's class is a Swift type name, which the registry creates, and its
# sources are Swift.
swift_type='^[A-Za-z_][A-Za-z0-9_]*(\.[A-Za-z_][A-Za-z0-9_]*)*$'
registry=$temporary/TokamakPluginRegistry.swift
printf '%s\n\n%s\n%s\n' 'import Foundation' 'func tokamakPlugins(host: TokamakHost) -> [any TokamakPlugin] {' '  [' > "$registry"
for plugin in "$input/plugins"/*/; do
  class=$(cat "$plugin/class" 2>/dev/null || true)
  if [[ ! "$class" =~ $swift_type ]]; then
    echo "plugin '$(basename "$plugin")' has invalid $platform class '$class'" >&2
    exit 1
  fi
  printf '    %s(host: host),\n' "$class" >> "$registry"
  for source in "$plugin/sources"/*; do
    case "$source" in
      *.swift) swift_sources+=("$source") ;;
      *)
        echo "Apple plugin source must be Swift: $source" >&2
        exit 1
        ;;
    esac
  done
done
printf '%s\n' '  ]' '}' >> "$registry"

# The executable exports only the entry points of the runtime parts the app
# links.
exported_symbols=$temporary/exported-symbols
sed 's/^/_/' "$metadata/exported-symbols" > "$exported_symbols"
swift_args=(
  "${swift_sources[@]}"
  "$registry"
  -target "$triple"
  -swift-version 5
  -Osize
  -whole-module-optimization
  -module-cache-path "$module_cache"
  -F "$framework_root"
  -framework TokamakRuntime
  -framework CoreFoundation
  -lc++
  -lresolv
  -Xlinker -dead_strip
  -Xlinker -exported_symbols_list -Xlinker "$exported_symbols"
)

# Simulator builds embed their entitlements in __TEXT,__entitlements, where
# the simulator reads them.
if [[ "$sdk" == iphonesimulator ]]; then
  simulator_entitlements=$temporary/simulator.entitlements
  "$apple_tool" simulator-entitlements --identifier "$identifier" --output "$simulator_entitlements"
  swift_args+=(-Xlinker -sectcreate -Xlinker __TEXT -Xlinker __entitlements -Xlinker "$simulator_entitlements")
fi

xcrun --sdk "$sdk" swiftc "${swift_args[@]}" -o "$executable_dir/$app_slug"
# Local symbols go; the exported entry points of linked parts stay.
xcrun --sdk "$sdk" strip -x "$executable_dir/$app_slug"

write_plist

sign_bundle
if [[ -n "${bundle_key:-}" ]]; then
  mkdir -p "$(dirname "$bundle_key_file")"
  printf '%s' "$bundle_key" > "$bundle_key_file"
fi
