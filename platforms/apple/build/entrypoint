#!/usr/bin/env bash
set -euo pipefail

# The CLI runs the entrypoint from the pack root.
pack=$PWD
apple_tool=$pack/tools/tokamak-apple-signing
if [[ ! -x "$apple_tool" ]]; then
  echo "Apple platform pack is missing its Apple helper: $apple_tool" >&2
  exit 1
fi
if [[ $# -eq 1 && $1 == certs ]]; then
  exec "$apple_tool" inventory
fi

# Describes the methods the plugin's registration file REGISTRATION exports
# on each PLATFORM into OUTPUT/description.json, with the dispatch that serves
# them, OUTPUT/Exports.generated.swift. The compiler's symbol graphs of the
# plugin's module and the plugin API, built for each platform, give the
# methods' types.
describe() {
  local plugin=$1 registration=$2 output=$3
  shift 3
  if ! xcrun --sdk iphonesimulator --show-sdk-path > /dev/null 2>&1; then
    echo "Describing an Apple plugin needs Xcode" >&2
    exit 69
  fi
  # Global, for the exit trap.
  temporary=$(mktemp -d "${TMPDIR:-/tmp}/tokamak-describe.XXXXXX")
  trap 'rm -rf "$temporary"' EXIT
  local platform destination class module packages graphs=() builds=()
  for platform in "$@"; do
    case "$platform" in
      ios) destination='generic/platform=iOS Simulator' ;;
      macos) destination='generic/platform=macOS' ;;
      *)
        echo "Apple plugins run on ios and macos, not $platform" >&2
        exit 2
        ;;
    esac
    class=$(plutil -extract "platforms.$platform.class" raw -o - "$plugin/tokamak-plugin.json")
    module=${class%%.*}
    # Each platform builds its own copy of the plugin's package, staged as the
    # app's build stages it, without the dispatch describing regenerates.
    packages=$temporary/$platform/packages
    mkdir -p "$packages/node_modules/@tokamakdev/plugin/apple"
    cp -R "$pack/plugin-api/TokamakPlugin" "$packages/node_modules/@tokamakdev/plugin/apple/"
    rsync -a --exclude .build --exclude .swiftpm "$plugin/apple/" "$packages/plugin/"
    find "$packages/plugin" -name Exports.generated.swift -delete
    # The platforms build at once, each into its own log.
    (
      cd "$packages/plugin"
      xcodebuild build -quiet -scheme "$module" -destination "$destination" \
        -derivedDataPath "$temporary/$platform/build" \
        -skipPackagePluginValidation -skipMacroValidation \
        ARCHS="$(uname -m)" ONLY_ACTIVE_ARCH=NO CODE_SIGNING_ALLOWED=NO \
        "OTHER_SWIFT_FLAGS=\$(inherited) -emit-symbol-graph -emit-symbol-graph-dir $temporary/$platform -symbol-graph-minimum-access-level private"
    ) > "$temporary/$platform.log" 2>&1 &
    builds+=("$!")
    graphs+=("$platform=$temporary/$platform/$module.symbols.json" "$platform=$temporary/$platform/TokamakPlugin.symbols.json")
  done
  # The platforms report the same diagnostics, so only the first failure's
  # show, or else the first platform's warnings.
  local platforms=("$@") index failed=
  for index in "${!builds[@]}"; do
    if ! wait "${builds[index]}" && [[ -z $failed ]]; then
      failed=$index
    fi
  done
  cat "$temporary/${platforms[${failed:-0}]}.log" >&2
  [[ -z $failed ]] || exit 1
  "$pack/tools/tokamak-swift-describe" "$registration" "$output" "${graphs[@]}"
}
if [[ $# -ge 5 && $1 == describe ]]; then
  describe "${@:2}"
  exit
fi

if [[ $# -ne 3 || $1 != build ]]; then
  echo "usage: entrypoint build INPUT OUTPUT | entrypoint describe PLUGIN REGISTRATION OUTPUT PLATFORM... | entrypoint certs" >&2
  exit 2
fi

input=$2
output=$3
metadata=$input/metadata
app_slug=$(cat "$metadata/app-slug")
identifier=$(cat "$metadata/identifier")
platform=$(cat "$metadata/platform")
target=$(cat "$metadata/target")
project_dir=$(cat "$metadata/project-dir")
minimum=$(<"$pack/build/$platform-deployment-target")
output_parent=$(dirname "$output")
temporary=$(mktemp -d "${TMPDIR:-/tmp}/tokamak-apple.XXXXXX")
trap 'rm -rf "$temporary"' EXIT

case "$target" in
  macos-arm64)
    sdk=macosx
    triple=arm64-apple-macos$minimum
    ;;
  macos-x64)
    sdk=macosx
    triple=x86_64-apple-macos$minimum
    ;;
  ios-arm64)
    sdk=iphoneos
    triple=arm64-apple-ios$minimum
    ;;
  ios-simulator-arm64)
    sdk=iphonesimulator
    triple=arm64-apple-ios$minimum-simulator
    ;;
  ios-simulator-x64)
    sdk=iphonesimulator
    triple=x86_64-apple-ios$minimum-simulator
    ;;
  *)
    echo "unsupported Apple target: $target" >&2
    exit 1
    ;;
esac

bundle=$output
if [[ "$platform" == macos ]]; then
  contents=$bundle/Contents
  executable_dir=$contents/MacOS
  resources_dir=$contents/Resources
  app_dir=$resources_dir/app
  icon=${TOKAMAK_MACOS_ICON:-}
  app_files=("${TOKAMAK_MACOS_PLIST:-}" "${TOKAMAK_MACOS_ENTITLEMENTS:-}")
else
  contents=$bundle
  executable_dir=$bundle
  resources_dir=$bundle
  app_dir=$bundle/app
  icon=${TOKAMAK_IOS_ICON:-}
  app_files=("${TOKAMAK_IOS_PLIST:-}" "${TOKAMAK_IOS_ENTITLEMENTS:-}")
fi
if [[ -n "$icon" && ! ( -d "$icon" && "$icon" == *.[iI][cC][oO][nN] ) ]]; then
  echo "$platform.icon must be an Icon Composer .icon package: $icon" >&2
  exit 1
fi
icon_info_plist=$output_parent/.tokamak/$(basename "$output").icon-info.plist

write_plist() {
  plist_args=(plist --input "$input" --output "$temporary/Info.plist")
  if [[ -n "$icon" ]]; then
    plist_args+=(--icon-info-plist "$icon_info_plist")
  fi
  "$apple_tool" "${plist_args[@]}"
  cp "$temporary/Info.plist" "$contents/Info.plist"
}

sign_bundle() {
  if [[ "$sdk" == iphonesimulator ]]; then
    codesign --force --timestamp=none --sign - "$bundle"
    return
  fi
  signing_args=(
    sign
    --platform "$platform"
    --project "$project_dir"
    --bundle "$bundle"
    --bundle-id "$identifier"
  )
  if [[ "$platform" == ios && -f "$metadata/device-id" ]]; then
    signing_args+=(--device-id "$(cat "$metadata/device-id")")
  fi
  "$apple_tool" "${signing_args[@]}"
}

# The bundle is reused while everything it is built from, apart from the
# Worker's environment and the signing settings, is unchanged.
bundle_key_file=$output_parent/.tokamak/$(basename "$output").input-key
key_files=("$input" "$pack")
for key_file in "$icon" "${app_files[@]}"; do
  if [[ -n "$key_file" ]]; then
    key_files+=("$key_file")
  fi
done
bundle_key=$(
  {
    find -L "${key_files[@]}" -type f ! -path "$input/app/worker-environment.json" -print0 |
      LC_ALL=C sort -z | xargs -0 shasum -a 256
    env | LC_ALL=C sort | sed -n '/^TOKAMAK_/p' |
      sed '/^TOKAMAK_IOS_TEAM_ID=/d; /^TOKAMAK_IOS_SIGNING_IDENTITY=/d; /^TOKAMAK_IOS_PROVISIONING_PROFILE=/d; /^TOKAMAK_MACOS_TEAM_ID=/d; /^TOKAMAK_IOS_BUILD_NUMBER=/d; /^TOKAMAK_MACOS_BUILD_NUMBER=/d'
    printf '%s\n' "${DEVELOPER_DIR:-}" "$PATH"
    xcodebuild -version
  } | shasum -a 256 | cut -d ' ' -f 1
)
if [[ -d "$bundle" && -f "$bundle_key_file" && $(cat "$bundle_key_file") == "$bundle_key" && ( -z "$icon" || -f "$icon_info_plist" ) ]]; then
  write_plist
  cp "$input/app/worker-environment.json" "$app_dir/worker-environment.json"
  sign_bundle
  exit 0
fi

rm -f "$bundle_key_file" "$icon_info_plist"
rm -rf "$bundle"
mkdir -p "$executable_dir" "$app_dir" "$output_parent/.tokamak"
cp -R "$input/app/." "$app_dir/"

if [[ -n "$icon" ]]; then
  if [[ "$platform" == macos ]]; then
    icon_targets=(--target-device mac)
  else
    icon_targets=(--target-device iphone --target-device ipad)
  fi
  # actool names the app icon after its package.
  cp -R "$icon" "$temporary/AppIcon.icon"
  xcrun --sdk "$sdk" actool \
    --compile "$resources_dir" \
    --platform "$sdk" \
    --minimum-deployment-target "$minimum" \
    --app-icon AppIcon \
    "${icon_targets[@]}" \
    --output-partial-info-plist "$icon_info_plist" \
    --output-format human-readable-text \
    "$temporary/AppIcon.icon"
fi

shopt -s nullglob

# The app is a Swift package, which xcodebuild builds: an executable of the
# shell and the plugin registry that depends on the runtime, the plugin API
# and each plugin's package. Each plugin's package is staged as its id, beside
# the plugin API at the path its dependency on the API names. The packages are
# generated here, then synced to the target's staging directory, whose
# unchanged files the build reuses. Its fixed paths also keep the pins of the
# lock file, which xcodebuild drops when the packages' paths change.
generated=$temporary/swift
packages=$generated/packages
app_package=$generated/app
staging=$output_parent/.tokamak/swift/$target
plugin_api=$staging/packages/node_modules/@tokamakdev/plugin/apple/TokamakPlugin
mkdir -p "$app_package/Sources/App" "$packages/node_modules/@tokamakdev/plugin/apple"
cp -R "$pack/plugin-api/TokamakPlugin" "$packages/node_modules/@tokamakdev/plugin/apple/"
cp "$pack/native-shell"/*.swift "$app_package/Sources/App/"
ln -s "$pack/frameworks/TokamakRuntime.xcframework" "$app_package/TokamakRuntime.xcframework"

# A plugin's class is a Swift type named with its module, which the package's
# library product of the module's name provides.
swift_type='^([A-Za-z_][A-Za-z0-9_]*)(\.[A-Za-z_][A-Za-z0-9_]*)+$'
# A plugin's compilation conditions start with its id in capitals, such as
# LOCATION_ for location, as each one applies to every module the app compiles.
compilation_conditions=
dependencies="    .package(path: \"$plugin_api\"),"$'\n'
products="        .product(name: \"TokamakPlugin\", package: \"TokamakPlugin\"),"$'\n'
imports=
registrations=
for plugin in "$input/plugins"/*/; do
  plugin_id=$(basename "$plugin")
  class=$(cat "$plugin/class" 2>/dev/null || true)
  if [[ ! "$class" =~ $swift_type ]]; then
    echo "plugin '$plugin_id' has invalid $platform class '$class'; name it with its module, as Module.Class" >&2
    exit 1
  fi
  module=${BASH_REMATCH[1]}
  if [[ ! -f "$plugin/native/Package.swift" ]]; then
    echo "plugin '$plugin_id' has no Swift package, apple/Package.swift" >&2
    exit 1
  fi
  condition_prefix=$(printf '%s' "$plugin_id" | tr 'a-z-' 'A-Z_')_
  for condition_file in "$plugin/compilation-conditions"/*; do
    condition=$(<"$condition_file")
    if [[ ! "$condition" =~ ^${condition_prefix}[A-Za-z0-9_]+$ ]]; then
      echo "plugin '$plugin_id' has compilation condition '$condition', which must be $condition_prefix followed by letters, digits or underscores" >&2
      exit 1
    fi
    compilation_conditions+=" $condition"
  done
  cp -R "$plugin/native" "$packages/$plugin_id"
  dependencies+="    .package(path: \"$staging/packages/$plugin_id\"),"$'\n'
  products+="        .product(name: \"$module\", package: \"$plugin_id\"),"$'\n'
  imports+="import $module"$'\n'
  registrations+="    $class(host: TokamakHost(app: app, plugin: \"$plugin_id\")),"$'\n'
done
{
  printf '%s\n' 'import TokamakPlugin'
  printf '%s' "$imports"
  printf '\n%s\n%s\n' 'func tokamakPlugins(app: TokamakApp) -> [any TokamakPlugin] {' '  ['
  printf '%s' "$registrations"
  printf '%s\n' '  ]' '}'
} > "$app_package/Sources/App/TokamakPluginRegistry.swift"

# The executable exports only the entry points of the runtime parts the app
# links, and finds the dynamic frameworks of plugins' dependencies in the
# bundle.
sed 's/^/_/' "$metadata/exported-symbols" > "$app_package/exported-symbols"
if [[ "$platform" == macos ]]; then
  frameworks_path=@executable_path/../Frameworks
else
  frameworks_path=@executable_path/Frameworks
fi
linker_flags="\"-Xlinker\", \"-exported_symbols_list\", \"-Xlinker\", \"$staging/app/exported-symbols\", \"-Xlinker\", \"-rpath\", \"-Xlinker\", \"$frameworks_path\""
# Simulator builds embed their entitlements in __TEXT,__entitlements, where
# the simulator reads them.
if [[ "$sdk" == iphonesimulator ]]; then
  "$apple_tool" simulator-entitlements --identifier "$identifier" --output "$app_package/simulator.entitlements"
  linker_flags+=", \"-Xlinker\", \"-sectcreate\", \"-Xlinker\", \"__TEXT\", \"-Xlinker\", \"__entitlements\", \"-Xlinker\", \"$staging/app/simulator.entitlements\""
fi
cat > "$app_package/Package.swift" <<EOF
// swift-tools-version: 5.9

import PackageDescription

let package = Package(
  name: "App",
  platforms: [.iOS("$(<"$pack/build/ios-deployment-target")"), .macOS("$(<"$pack/build/macos-deployment-target")")],
  dependencies: [
$dependencies  ],
  targets: [
    .binaryTarget(name: "TokamakRuntime", path: "TokamakRuntime.xcframework"),
    .executableTarget(
      name: "App",
      dependencies: [
        "TokamakRuntime",
$products      ],
      linkerSettings: [
        .linkedFramework("CoreFoundation"),
        .linkedLibrary("c++"),
        .linkedLibrary("resolv"),
        .unsafeFlags([$linker_flags]),
      ]
    ),
  ]
)
EOF

swift_build=$output_parent/.tokamak/swift-build/$target
# The app's lock file pins the versions of plugins' dependencies, which
# resolving updates for changed requirements. Without one, the build resolves
# the newest versions they allow, rather than those it resolved before.
lock=$input/lock/Package.resolved
if [[ -f "$lock" ]]; then
  cp "$lock" "$app_package/Package.resolved"
else
  rm -rf "${swift_build:?}/SourcePackages"
fi
mkdir -p "$staging"
rsync -rlp --checksum --delete --exclude .swiftpm "$generated/" "$staging/"
case "$sdk" in
  macosx)
    destination='generic/platform=macOS'
    products_dir=Release
    ;;
  iphoneos)
    destination='generic/platform=iOS'
    products_dir=Release-iphoneos
    ;;
  iphonesimulator)
    destination='generic/platform=iOS Simulator'
    products_dir=Release-iphonesimulator
    ;;
esac
products=$swift_build/Build/Products/$products_dir
# The build writes the resource bundles and frameworks of the packages the
# app has now, without those of removed ones.
rm -rf "${products:?}"/*.bundle "${products:?}/PackageFrameworks"
# Packages' build tool plugins and macros run without the prompt Xcode
# shows, as plugins' build scripts do. The build keeps the exported entry
# points, which Xcode's own strip removes, and writes no dSYM.
(
  cd "$staging/app"
  xcodebuild build -quiet \
    -scheme App \
    -destination "$destination" \
    -configuration Release \
    -derivedDataPath "$swift_build" \
    -skipPackagePluginValidation \
    -skipMacroValidation \
    ARCHS="${triple%%-*}" \
    ONLY_ACTIVE_ARCH=NO \
    CODE_SIGNING_ALLOWED=NO \
    SWIFT_OPTIMIZATION_LEVEL=-Osize \
    SWIFT_COMPILATION_MODE=wholemodule \
    DEAD_CODE_STRIPPING=YES \
    STRIP_INSTALLED_PRODUCT=NO \
    DEBUG_INFORMATION_FORMAT=dwarf \
    "SWIFT_ACTIVE_COMPILATION_CONDITIONS=\$(inherited)$compilation_conditions"
)
if [[ -f "$staging/app/Package.resolved" ]]; then
  mkdir -p "$input/lock"
  cp "$staging/app/Package.resolved" "$lock"
fi
cp "$products/App" "$executable_dir/$app_slug"
# Local symbols go; the exported entry points of linked parts stay.
xcrun --sdk "$sdk" strip -x "$executable_dir/$app_slug"

# Packages' resource bundles go in the bundle's resources directory, where
# their Bundle.module finds them, and dynamic frameworks in its frameworks
# directory.
for resource_bundle in "$products"/*.bundle; do
  cp -R "$resource_bundle" "$resources_dir/"
done
for framework in "$products"/PackageFrameworks/*.framework; do
  mkdir -p "$contents/Frameworks"
  cp -R "$framework" "$contents/Frameworks/"
done

write_plist

# Plugins' resources go in the bundle's resources directory, where the system
# finds files such as notification sounds by name.
for resource in "$input/plugins"/*/resources/*; do
  [[ -f "$resource" ]] || continue
  name=${resource##*/}
  name=${name#*-}
  if [[ -e "$resources_dir/$name" ]]; then
    echo "plugin resource '$name' would replace a file in the app bundle" >&2
    exit 1
  fi
  cp "$resource" "$resources_dir/$name"
done

sign_bundle
mkdir -p "$(dirname "$bundle_key_file")"
printf '%s' "$bundle_key" > "$bundle_key_file"
