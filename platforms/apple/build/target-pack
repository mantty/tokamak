#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 4 || "$1" != build ]]; then
  echo "usage: target-pack build TARGET RUST_TARGET OUTPUT" >&2
  exit 2
fi

target=$2
rust_target=$3
output=$4
workspace=$PWD

case "$target" in
  macos-arm64|macos-x64)
    export MACOSX_DEPLOYMENT_TARGET=14.0
    ;;
  ios-arm64)
    export IPHONEOS_DEPLOYMENT_TARGET=17.0
    ;;
  ios-simulator-arm64|ios-simulator-x64)
    export IPHONEOS_DEPLOYMENT_TARGET=17.0
    export IPHONESIMULATOR_DEPLOYMENT_TARGET=17.0
    ;;
  *)
    echo "unsupported Apple target: $target" >&2
    exit 1
    ;;
esac

rm -rf "$output"
mkdir -p \
  "$output/build" \
  "$output/frameworks/TokamakRuntime.framework/Headers" \
  "$output/frameworks/TokamakRuntime.framework/Modules" \
  "$output/native-shell" \
  "$output/tools"

host_targets=(aarch64-apple-darwin x86_64-apple-darwin)
for host_target in "${host_targets[@]}"; do
  cargo build \
    --package tokamak-apple-signing \
    --release \
    --target "$host_target"
done

lipo -create \
  "$workspace/target/aarch64-apple-darwin/release/tokamak-apple-signing" \
  "$workspace/target/x86_64-apple-darwin/release/tokamak-apple-signing" \
  -output "$output/tools/tokamak-apple-signing"

cargo rustc \
  --package tokamak \
  --release \
  --target "$rust_target" \
  --features native \
  --lib \
  --crate-type staticlib

library="$workspace/target/$rust_target/release/libtokamak.a"
if [[ ! -f "$library" ]]; then
  echo "tokamak runtime library was not produced: $library" >&2
  exit 1
fi

cp "$library" "$output/frameworks/TokamakRuntime.framework/TokamakRuntime"
cp "$workspace/platforms/apple/source/TokamakRuntime.h" \
  "$output/frameworks/TokamakRuntime.framework/Headers/TokamakRuntime.h"
cp "$workspace/platforms/apple/source/module.modulemap" \
  "$output/frameworks/TokamakRuntime.framework/Modules/module.modulemap"
cp "$workspace/platforms/apple/source/TokamakShell.swift" \
  "$output/native-shell/TokamakShell.swift"
cp "$workspace/platforms/apple/source/TokamakPlugins.swift" \
  "$output/native-shell/TokamakPlugins.swift"
cp "$workspace/platforms/apple/build/entrypoint" \
  "$output/build/entrypoint"
