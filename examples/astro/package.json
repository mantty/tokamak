{
  "name": "tokamak-example-astro",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "tokamak:android": "astro build && ../../target/release/tok build android --project . --wrangler dist/server/wrangler.json --skip-web-build",
    "tokamak:macos": "astro build && ../../target/release/tok build macos --project . --wrangler dist/server/wrangler.json --skip-web-build",
    "tokamak:ios": "astro build && ../../target/release/tok build ios --project . --wrangler dist/server/wrangler.json --skip-web-build",
    "tokamak:ios-simulator": "astro build && ../../target/release/tok build ios-simulator --project . --wrangler dist/server/wrangler.json --skip-web-build"
  },
  "dependencies": {
    "@tokamak/geolocation": "link:../../plugins/geolocation",
    "@astrojs/cloudflare": "13.1.8",
    "@tailwindcss/vite": "^4.2.2",
    "astro": "6.1.5",
    "tailwindcss": "^4.2.2"
  }
}
