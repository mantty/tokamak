---
// Static page — prerendered at build time. Timestamp is frozen.
export const prerender = true;

import Base from "../layouts/Base.astro";
import TimestampCard from "../components/TimestampCard.astro";

const now = new Date();
const timestamp = now.toISOString();
const rendered = now.toLocaleString("en-GB", { timeZone: "UTC" });
---

<Base title="About - tokamak Example">
  <h1 class="text-3xl font-bold text-white mb-6">About</h1>

  <div class="rounded-xl border border-indigo-800/50 bg-indigo-900/30 p-6 mb-8">
    <h2 class="text-lg font-semibold text-white mb-2">Static Page</h2>
    <p class="text-indigo-300 mb-4">
      This page was prerendered at build time. The timestamp below is fixed and
      does not change on reload. Compare it with the home page's server-side
      timestamp.
    </p>
    <TimestampCard label="Build time (UTC):" rendered={rendered} timestamp={timestamp} />
  </div>

  <div class="rounded-xl border border-indigo-800/50 bg-indigo-900/30 p-6">
    <h2 class="text-lg font-semibold text-white mb-2">tokamak</h2>
    <p class="text-indigo-300">
      tokamak packages Cloudflare Workers-compatible web apps as native apps on
      macOS and iOS. The same QuickJS runtime runs in-process inside both native
      shells.
    </p>
  </div>

  <div class="mt-6">
    <a
      href="/"
      class="text-indigo-300 hover:text-white transition-colors"
    >
      &larr; Back to Home
    </a>
  </div>
</Base>
