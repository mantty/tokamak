---
import PluginCard from "./PluginCard.astro";
---

<PluginCard title="Location" log="location-log">
  <p class="text-indigo-300 mb-4">
    Asks for location while the app is in use. When the app starts on screen,
    src/tokamak.ts also records where the Worker first places the device.
  </p>
  <div class="flex flex-wrap gap-3">
    <button id="location-current" class="button">Current position</button>
    <button id="location-watch" class="button">Watch position</button>
  </div>
</PluginCard>

<script>
  import { location, type Position } from "@tokamakdev/plugin-location";
  import { describe, logTo, onClick } from "../scripts/plugin-log";

  const log = logTo("location-log");
  const watch = document.getElementById("location-watch")!;
  let stopWatching: (() => void) | undefined;

  function format({ coords }: Position): string {
    return `${coords.latitude.toFixed(5)}, ${coords.longitude.toFixed(5)} within ${Math.round(coords.accuracy)} m`;
  }

  function stop() {
    stopWatching?.();
    stopWatching = undefined;
    watch.textContent = "Watch position";
  }

  // Accepts a position up to a minute old, and waits up to 10 seconds for a new one.
  onClick(log, "location-current", async () =>
    format(await location.getCurrentPosition({ maximumAge: 60_000, timeout: 10_000 })),
  );

  watch.addEventListener("click", () => {
    if (stopWatching) {
      stop();
      log("Stopped watching");
      return;
    }
    stopWatching = location.watchPosition(
      (position) => log(`Position: ${format(position)}`),
      (error) => {
        stop();
        log(`Watch position: ${describe(error)}`);
      },
    );
    watch.textContent = "Stop watching";
  });
</script>
