---
// Client-side WebSocket ping/pong component
---

<div class="rounded-xl border border-indigo-800/50 bg-indigo-900/30 p-6">
  <h2 class="text-lg font-semibold text-white mb-4">WebSocket Ping/Pong</h2>
  <div class="flex items-center gap-4 mb-4">
    <button
      id="ping-btn"
      class="button"
    >
      Ping
    </button>
    <span id="ws-status" class="text-sm text-indigo-400">Connecting...</span>
  </div>
  <div
    class="font-mono text-sm text-indigo-300 bg-indigo-950/50 rounded-lg p-4 space-y-2"
    aria-live="polite"
  >
    <div id="ws-ping">Ping: —</div>
    <div id="ws-pong">Pong: —</div>
  </div>
</div>

<script>
  const btn = document.getElementById("ping-btn") as HTMLButtonElement;
  const status = document.getElementById("ws-status")!;
  const ping = document.getElementById("ws-ping")!;
  const pong = document.getElementById("ws-pong")!;

  const proto = location.protocol === "https:" ? "wss:" : "ws:";
  const ws = new WebSocket(`${proto}//${location.host}/api/ws`);

  function setStatus(text: string, className: string, enabled: boolean) {
    status.textContent = text;
    status.className = className;
    btn.disabled = !enabled;
  }

  ws.onopen = () => setStatus("Connected", "text-sm text-emerald-400", true);
  ws.onmessage = (e) => {
    pong.textContent = `Pong: ${e.data}`;
  };
  ws.onclose = () => setStatus("Disconnected", "text-sm text-red-400", false);

  ws.onerror = () => {
    setStatus("Error", "text-sm text-red-400", false);
  };

  btn.disabled = true;
  btn.addEventListener("click", () => {
    const msg = `ping ${Date.now()}`;
    ws.send(msg);
    ping.textContent = `Ping: ${msg}`;
    pong.textContent = "Pong: waiting...";
  });
</script>
