<div class="rounded-xl border border-indigo-800/50 bg-indigo-900/30 p-6">
  <h2 class="text-lg font-semibold text-white mb-4">Runtime Word Picker</h2>
  <div class="flex items-center gap-4 mb-4">
    <button
      id="word-btn"
      class="button"
    >
      Get a random word
    </button>
    <span id="word-result" class="text-sm text-indigo-400"
      >Click to pick a word</span
    >
  </div>
  <div
    id="word-log"
    class="font-mono text-sm text-indigo-300 bg-indigo-950/50 rounded-lg p-4 h-40 overflow-y-auto"
  >
  </div>
</div>

<script>
  const btn = document.getElementById("word-btn") as HTMLButtonElement;
  const result = document.getElementById("word-result")!;
  const log = document.getElementById("word-log")!;

  function appendLog(msg: string) {
    const line = document.createElement("div");
    line.textContent = `[${new Date().toISOString().slice(11, 23)}] ${msg}`;
    log.appendChild(line);
    log.scrollTop = log.scrollHeight;
  }

  btn.addEventListener("click", async () => {
    btn.disabled = true;
    result.textContent = "Picking...";
    try {
      const res = await fetch("/api/word");
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const { word, seed } = await res.json();
      result.textContent = word;
      appendLog(`seed ${seed} -> "${word}"`);
    } catch (err) {
      result.textContent = "Error";
      appendLog(`Error: ${err}`);
    } finally {
      btn.disabled = false;
    }
  });
</script>
