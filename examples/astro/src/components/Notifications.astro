---
import PluginCard from "./PluginCard.astro";
---

<PluginCard title="Notifications" log="notifications-log">
  <p class="text-indigo-300 mb-4">
    Local notifications need only permission. src/tokamak.ts sets up the
    "message" category's actions and the Android channels at each start, and
    records push messages and opened and dismissed notifications on the Events
    page. Push needs the declarations the plugin's README lists, which this
    example does not make, so subscribing reports what is missing.
  </p>
  <div class="flex flex-wrap gap-3">
    <button id="notifications-permission" class="button">Permission</button>
    <button id="notifications-request" class="button">Request permission</button>
    <button id="notifications-settings" class="button">Settings</button>
    <button id="notifications-open-settings" class="button">Open settings</button>
    <button id="notifications-badge" class="button">Badge 3</button>
    <button id="notifications-clear-badge" class="button">Clear badge</button>
    <button id="notifications-show" class="button">Show now</button>
    <button id="notifications-message" class="button">Show a message</button>
    <button id="notifications-group" class="button">Show a group</button>
    <button id="notifications-photo" class="button">Show a photo</button>
    <button id="notifications-progress" class="button">Show progress</button>
    <button id="notifications-silent" class="button">Show silently, badge 5</button>
    <button id="notifications-chime" class="button">Show with a chime</button>
    <button id="notifications-schedule" class="button">Schedule in 10 s</button>
    <button id="notifications-exact" class="button">Exact in 10 s (Android)</button>
    <button id="notifications-every" class="button">Every minute</button>
    <button id="notifications-daily" class="button">Daily at 9:00</button>
    <button id="notifications-region" class="button">On leaving here (iOS)</button>
    <button id="notifications-list" class="button">Scheduled and delivered</button>
    <button id="notifications-remove" class="button">Remove all</button>
    <button id="notifications-subscribe" class="button">Subscribe</button>
    <button id="notifications-subscription" class="button">Subscription</button>
    <button id="notifications-unsubscribe" class="button">Unsubscribe</button>
    <button id="notifications-topic" class="button">Subscribe to "news" (FCM)</button>
  </div>
</PluginCard>

<script>
  import location from "@tokamakdev/plugin-location/client";
  import notifications from "@tokamakdev/plugin-notifications/client";
  import type { Message, OpenedNotification, DismissedNotification, OpenSettingsEvent, Subscription } from "@tokamakdev/plugin-notifications";
  import { describe, logTo, onClick, listen } from "../scripts/plugin-log";

  const log = logTo("notifications-log");
  const reportError = (error: unknown) => log(describe(error));

  onClick(log, "notifications-permission", () => notifications.permission());
  // Apple platforms then link from their settings to the app's, which onOpenSettings receives.
  onClick(log, "notifications-request", () =>
    notifications.requestPermission({ providesAppNotificationSettings: true }),
  );
  onClick(log, "notifications-settings", () => notifications.settings());
  onClick(log, "notifications-open-settings", () => notifications.openSettings());
  onClick(log, "notifications-badge", () => notifications.setBadge(3));
  onClick(log, "notifications-clear-badge", () => notifications.setBadge(0));
  onClick(log, "notifications-show", () =>
    notifications.show({ id: "example-now", title: "Shown now", body: "From the Plugins page" }),
  );
  // The Worker's `setup` defines the "message" category's actions and the "messages" channel.
  onClick(log, "notifications-message", () =>
    notifications.show({
      id: "example-message",
      title: "Ada",
      body: "Are you coming tonight?",
      category: "message",
      channel: "messages",
      settingsText: "Notification settings",
    }),
  );
  // Grouped on Apple and Android, with Android's messaging and big text styles.
  onClick(log, "notifications-group", async () => {
    await notifications.show({
      id: "example-group-ada",
      title: "Ada",
      subtitle: "Supper club",
      body: "Are you coming tonight?",
      group: "supper-club",
      badge: 2,
      timestamp: Date.now() - 60_000,
      category: "message",
      channel: "messages",
      androidCategory: "message",
      relevanceScore: 0.8,
      style: {
        type: "messaging",
        user: "Me",
        conversationTitle: "Supper club",
        messages: [
          { text: "Shall we book for eight?", at: Date.now() - 120_000 },
          { text: "Are you coming tonight?", at: Date.now() - 60_000, sender: "Ada" },
        ],
      },
    });
    await notifications.show({
      id: "example-group-grace",
      title: "Grace",
      subtitle: "Supper club",
      body: "I'll bring dessert.",
      group: "supper-club",
      badge: 2,
      channel: "messages",
      style: { type: "bigText", text: "I'll bring dessert. Is anyone allergic to nuts?" },
    });
  });
  // Apple attaches the image; Android shows it in the big picture style, with the large icon.
  onClick(log, "notifications-photo", () =>
    notifications.show({
      id: "example-photo",
      title: "Grace",
      body: "Sent a photo",
      image: "/notifications/hero.jpg",
      icon: "/notifications/icon.png",
      channel: "messages",
      style: { type: "bigPicture", summary: "From the supper club", showWhenCollapsed: true },
    }),
  );
  // Android shows the bar, the elapsed time and the line under the app's name.
  onClick(log, "notifications-progress", () =>
    notifications.show({
      id: "example-progress",
      title: "Downloading",
      body: "report.pdf",
      subText: "3 of 10 MB",
      progress: { current: 3, max: 10 },
      timestamp: Date.now(),
      chronometer: true,
      ongoing: true,
      onlyAlertOnce: true,
      silent: true,
      androidCategory: "progress",
    }),
  );
  onClick(log, "notifications-silent", () =>
    notifications.show({ id: "example-silent", title: "Silent", body: "No sound or vibration", silent: true, badge: 5 }),
  );
  onClick(log, "notifications-schedule", () =>
    notifications.schedule({
      id: "example-scheduled",
      title: "Scheduled",
      body: "Shown 10 seconds after scheduling",
      data: { scheduledAt: Date.now() },
      at: Date.now() + 10_000,
    }),
  );
  // The sound is a file of the notifications.sounds build setting; Android plays the channel's.
  onClick(log, "notifications-chime", () =>
    notifications.show({
      id: "example-chime",
      title: "Chime",
      body: "Played from the app's sounds",
      sound: { name: "chime.wav" },
      channel: "chimes",
    }),
  );
  onClick(log, "notifications-exact", () =>
    notifications.schedule({
      id: "example-exact",
      title: "Exact",
      body: "Shown 10 seconds after scheduling, to the second",
      at: Date.now() + 10_000,
      exact: true,
    }),
  );
  onClick(log, "notifications-every", () =>
    notifications.schedule({ id: "example-every", title: "Every minute", body: "Until removed", every: { minutes: 1 } }),
  );
  onClick(log, "notifications-daily", () =>
    notifications.schedule({ id: "example-daily", title: "Good morning", on: { hour: 9, minute: 0 }, repeats: true }),
  );
  onClick(log, "notifications-region", async () => {
    const { coords } = await location.getCurrentPosition();
    await notifications.schedule({
      id: "example-region",
      title: "You left",
      body: "Shown on leaving where you scheduled it",
      region: { latitude: coords.latitude, longitude: coords.longitude, radius: 200, onEntry: false, onExit: true },
    });
  });
  onClick(log, "notifications-list", async () => ({
    scheduled: await notifications.getScheduled(),
    delivered: await notifications.getDelivered(),
  }));
  onClick(log, "notifications-remove", async () => {
    await notifications.remove("example-now");
    await notifications.remove("example-message");
    await notifications.remove("example-group-ada");
    await notifications.remove("example-group-grace");
    await notifications.remove("example-photo");
    await notifications.remove("example-progress");
    await notifications.remove("example-silent");
    await notifications.remove("example-scheduled");
    for (const id of ["example-chime", "example-exact", "example-every", "example-daily", "example-region"]) {
      await notifications.remove(id);
    }
  });
  onClick(log, "notifications-subscribe", () => notifications.subscribe());
  onClick(log, "notifications-subscription", () => notifications.getSubscription());
  onClick(log, "notifications-unsubscribe", () => notifications.unsubscribe());
  onClick(log, "notifications-topic", () => notifications.subscribeToTopic("news"));

  listen<Message>(notifications.onMessage(), (message) => log(`Message: ${JSON.stringify(message)}`), reportError);
  listen<OpenedNotification>(notifications.onNotificationOpened(), (opened) => log(`Opened: ${JSON.stringify(opened)}`), reportError);
  listen<DismissedNotification>(notifications.onNotificationDismissed(),
    (dismissed) => log(`Dismissed: ${JSON.stringify(dismissed)}`),
    reportError,
  );
  listen<OpenSettingsEvent>(notifications.onOpenSettings(), (request) => log(`Open settings: ${JSON.stringify(request)}`), reportError);
  listen<Subscription>(notifications.onSubscriptionChange(),
    (subscription) => log(`Subscription changed: ${JSON.stringify(subscription)}`),
    reportError,
  );
</script>
