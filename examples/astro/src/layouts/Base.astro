---
import "../styles/global.css";

const { title } = Astro.props as { title: string };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body class="bg-indigo-950 text-indigo-100 min-h-screen">
    <nav class="border-b border-indigo-800/50 px-6 py-4">
      <div class="max-w-4xl mx-auto flex items-center gap-6">
        <a href="/" class="text-lg font-bold text-white">tokamak</a>
        <a href="/" class="text-indigo-300 hover:text-white transition-colors"
          >Home</a
        >
        <a
          href="/about"
          class="text-indigo-300 hover:text-white transition-colors">About</a
        >
        <a
          href="/events"
          class="text-indigo-300 hover:text-white transition-colors">Events</a
        >
        <a
          href="/plugins"
          class="text-indigo-300 hover:text-white transition-colors">Plugins</a
        >
      </div>
    </nav>
    <main class="max-w-4xl mx-auto px-6 py-8">
      <slot />
    </main>
  </body>
</html>
