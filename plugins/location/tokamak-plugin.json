{
  "schemaVersion": 2,
  "id": "location",
  "settings": {
    "background": {
      "kind": "boolean",
      "default": false,
      "description": "Declares background location permission: Apple's Always, Android's ACCESS_BACKGROUND_LOCATION"
    },
    "background-updates": {
      "kind": "boolean",
      "default": false,
      "description": "Declares continuous updates off screen: iOS's location background mode, and Android's location foreground service"
    },
    "precision": {
      "kind": "enum",
      "values": [
        "precise",
        "approximate"
      ],
      "default": "precise",
      "description": "The precision the app declares; approximate leaves out precise location"
    },
    "when-in-use-description": {
      "kind": "string",
      "description": "Apple only: the reason the in-use prompt shows"
    },
    "always-description": {
      "kind": "string",
      "description": "iOS only: the reason the Always prompt shows"
    },
    "accuracy-purposes": {
      "kind": "map",
      "of": "string",
      "description": "Apple only: the reasons for temporary precise location, by purpose key"
    }
  },
  "build": "build/index.mjs",
  "platforms": {
    "macos": {
      "class": "TokamakLocationPlugin",
      "sources": [
        "apple/LocationEvents.swift",
        "apple/LocationPlugin.swift",
        "apple/LocationRegions.swift",
        "apple/LocationUpdates.swift"
      ]
    },
    "ios": {
      "class": "TokamakLocationPlugin",
      "sources": [
        "apple/LocationEvents.swift",
        "apple/LocationPlugin.swift",
        "apple/LocationRegions.swift",
        "apple/LocationUpdates.swift"
      ]
    },
    "android": {
      "class": "com.tokamak.plugins.location.TokamakLocationPlugin",
      "sources": [
        "android/LocationEvents.kt",
        "android/LocationPlugin.kt",
        "android/LocationReceiver.kt",
        "android/LocationRegions.kt",
        "android/LocationService.kt",
        "android/LocationUpdates.kt"
      ]
    }
  },
  "api": {
    "module": "src/index.ts",
    "export": "location"
  },
  "web": {
    "module": "web/client.ts",
    "export": "location"
  },
  "operations": {
    "getCurrentPosition": {
      "foreground": [
        "ios"
      ]
    },
    "watchPosition": {
      "foreground": [
        "ios"
      ]
    },
    "requestPermission": {
      "foreground": [
        "ios",
        "android"
      ]
    },
    "openSettings": {
      "foreground": [
        "ios",
        "android"
      ]
    },
    "startUpdates": {
      "foreground": [
        "ios",
        "android"
      ]
    },
    "onVisit": {
      "platforms": {
        "ios": true,
        "macos": true
      }
    }
  }
}
