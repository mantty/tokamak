{
  "schemaVersion": 2,
  "id": "local-authentication",
  "bindings": {
    "apple": {
      "sdk": "26.2",
      "modules": [
        "LocalAuthentication"
      ]
    },
    "android": {
      "sdk": 35,
      "modules": [
        "android.hardware.biometrics",
        "android.content.Context",
        "android.os.CancellationSignal",
        "java.util.concurrent.Executor"
      ]
    }
  },
  "platforms": {
    "macos": {
      "class": "TokamakLocalAuthenticationPlugin",
      "sources": [
        "apple/LocalAuthenticationPlugin.swift"
      ]
    },
    "ios": {
      "class": "TokamakLocalAuthenticationPlugin",
      "sources": [
        "apple/LocalAuthenticationPlugin.swift"
      ],
      "plist": "apple/Info.plist"
    },
    "android": {
      "class": "com.tokamak.plugins.localauthentication.TokamakLocalAuthenticationPlugin",
      "sources": [
        "android/LocalAuthenticationPlugin.kt"
      ],
      "manifest": "android/AndroidManifest.xml"
    }
  },
  "api": {
    "module": "src/index.ts",
    "export": "localAuthentication"
  }
}
