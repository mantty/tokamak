{
  "name": "@tokamakdev/plugin",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mantty/tokamak.git",
    "directory": "plugins/core"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./streams": "./src/streams.ts",
    "./events": "./src/events.ts",
    "./worker": "./src/worker.ts",
    "./testing": "./src/testing.ts",
    "./native-protocol": "./src/native-protocol.ts",
    "./contracts": "./src/contracts.generated.ts",
    "./capabilities": "./src/capabilities.ts"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "prepack": "pnpm build"
  },
  "files": [
    "dist",
    "src",
    "apple/TokamakPlugin/Package.swift",
    "apple/TokamakPlugin/Sources",
    "android/build.gradle.kts",
    "android/src"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./src/index.ts",
      "./streams": "./src/streams.ts",
      "./events": "./src/events.ts",
      "./worker": "./src/worker.ts",
      "./testing": "./src/testing.ts",
      "./native-protocol": {
        "types": "./dist/native-protocol.d.ts",
        "default": "./dist/native-protocol.js"
      },
      "./contracts": "./src/contracts.generated.ts",
      "./capabilities": {
        "types": "./dist/capabilities.d.ts",
        "default": "./dist/capabilities.js"
      }
    }
  }
}
