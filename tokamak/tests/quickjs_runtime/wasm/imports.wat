  (func $double (export "double") (export "alias") (param i32) (result i32) local.get 0 i32.const 2 i32.mul)
  (elem (i32.const 0) $double)
  (elem $passive func $double)
  (func (export "init") i32.const 0 i32.const 0 i32.const 1 table.init $passive)
  (func (export "indirect") (param i32 i32) (result i32) local.get 1 local.get 0 call_indirect (type $unary))
  (func (export "bump") (result i32) global.get $counter i32.const 1 i32.add global.set $counter call $notify global.get $counter)
