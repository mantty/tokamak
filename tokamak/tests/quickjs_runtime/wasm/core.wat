(module
  (import "env" "notify" (func $notify (param i32) (result i32)))
  (import "env" "limit" (global $limit i32))
  (memory (export "memory") (export "alias") 1 4)
  (global $counter (export "counter") (mut i32) (i32.const 7))
  (func $start i32.const 5 call $notify drop)
  (start $start)
  (func (export "add") (param i32 i32) (result i32) local.get 0 local.get 1 i32.add)
  (func (export "callback") (param i32) (result i32) local.get 0 call $notify)
  (func (export "load") (param i32) (result i32) local.get 0 i32.load)
  (func (export "store") (param i32 i32) local.get 0 local.get 1 i32.store)
  (func (export "grow") (param i32) (result i32) local.get 0 memory.grow)
  (func (export "growAndCallback") (param i32) (result i32) local.get 0 memory.grow drop i32.const 99 call $notify)
  (func (export "limit") (result i32) global.get $limit)
  (func (export "increment") (result i32) global.get $counter i32.const 1 i32.add global.set $counter global.get $counter)
  (func (export "wide") (param i64) (result i64) local.get 0 i64.const 1 i64.add)
  (func (export "float") (param f32 f64) (result f64) local.get 0 f64.promote_f32 local.get 1 f64.add)
  (func (export "pair") (result i32 i64) i32.const 3 i64.const 9)
  (func (export "trap") unreachable)
  (func (export "loop") (loop $forever br $forever))
)
