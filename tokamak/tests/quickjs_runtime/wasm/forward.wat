(module
  (type $unary (func (param i32) (result i32)))
  (import "other" "function" (func $f (type $unary)))
  (import "other" "reference" (global $reference externref))
  (import "other" "refCallback" (func $refCallback (param externref funcref) (result externref funcref)))
  (import "other" "wide" (global $wide (mut i64)))
  (export "alias" (func $f))
  (global (export "functionGlobal") funcref (ref.func $f))
  (global (export "nullGlobal") (mut externref) (ref.null extern))
  (global (export "reference") externref (global.get $reference))
  (table (export "table") 1 funcref)
  (elem (i32.const 0) $f)
  (table $refs (export "refsTable") 1 externref)
  (elem (table $refs) (i32.const 0) externref (global.get $reference))
  (elem $passive externref (global.get $reference))
  (func (export "initRefs") i32.const 0 i32.const 0 i32.const 1 table.init $refs $passive)
  (func (export "call") (type $unary) local.get 0 call $f)
  (func (export "tail") (type $unary) local.get 0 return_call $f)
  (func (export "indirect") (type $unary) local.get 0 i32.const 0 call_indirect (type $unary))
  (func (export "refs") (param externref funcref) (result externref funcref) local.get 0 local.get 1 call $refCallback)
  (func (export "wide") (result i64) global.get $wide i64.const 1 i64.add global.set $wide global.get $wide)
)
